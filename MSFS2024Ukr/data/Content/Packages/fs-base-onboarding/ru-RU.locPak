      "MYLIBRARY.NOTIF_PACKAGE_NEW_INSTALL_PATH_SET_TITLE": "Новое хранилище",
      "MYLIBRARY.NOTIF_PAN_PACKAGE_NEW_INSTALL_PATH_SET_DESC": "Новое хранилище успешно модифицировано.",
