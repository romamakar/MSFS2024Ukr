      "LanguageDll.12374": "Ручка калибровки высотомера (%((A:KOHLSMAN SETTING HG:2, mbar))%!d! мбар)",
      "LanguageDll.12384": "Основной переключатель автопилота (%((A:AUTOPILOT MASTER,BOOL))%{if}on%{else}off%{end})",
