      "LanguageDll.12960": "Двигатель 1\u00A0— переключатель магнето (%((A:Recip eng right magneto:1,bool) 2 * (A:Recip eng left magneto:1,bool) +)%{case}%{:0}Off%{:1}Left%{:2}Right%{:3}Both%{end})",
