      "LanguageDll.12349": "Резервное электропитание (%1!!%{if}on%{else}off%{end})",
      "LanguageDll.12350": "Система ПОЗ (%1!!%{if}on%{else}off%{end})",
      "LanguageDll.12351": "Селекторы подачи топлива (%1!!%{if}not all on%{else}all on%{end})",
      "LanguageDll.12368": "Высотомер (%((A:INDICATED ALTITUDE,METERS))%!d! м)",
      "LanguageDll.12369": "Высотомер (%((A:INDICATED ALTITUDE,FEET))%!d! фут)",
      "LanguageDll.12370": "Высотомер (%((P:UNITS OF MEASURE, ENUM))%{case}%{:2}%((A:INDICATED ALTITUDE,METERS))%!d!, meters%{else}%((A:INDICATED ALTITUDE,FEET))%!d!, feet%{end})",
      "LanguageDll.12371": "Ручка калибровки высотомера (%((A:KOHLSMAN SETTING HG, inHg))%!1.2f! дюйм. рт. ст.)",
      "LanguageDll.12372": "Ручка калибровки высотомера (%((A:KOHLSMAN SETTING HG, mbar))%!d! мбар)",
