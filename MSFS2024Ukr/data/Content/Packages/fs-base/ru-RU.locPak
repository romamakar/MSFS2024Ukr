      "LanguageDll.1": "00000409",
      "LanguageDll.10": "Файл Dem4km.bgl отсутствует или повреждён. Переустановите Flight Simulator, чтобы восстановить или исправить файл. Игра Flight Simulator будет закрыта.",
      "LanguageDll.11": "Файл Seasons.bgl отсутствует или повреждён. Переустановите Flight Simulator, чтобы восстановить или исправить файл. Игра Flight Simulator будет закрыта.",
      "LanguageDll.12": "Файл Lclookup.bgl отсутствует или повреждён. Переустановите Flight Simulator, чтобы восстановить или исправить файл. Игра Flight Simulator будет закрыта.",
      "LanguageDll.12289": "Указатель воздушной скорости (%((A:AIRSPEED SELECT INDICATED OR TRUE, kilometers/hour))%!d! км/ч)",
      "LanguageDll.12290": "Указатель воздушной скорости (%((A:AIRSPEED SELECT INDICATED OR TRUE, knots))%!d! узл.)",
      "LanguageDll.12296": "Радиовысотомер (%((A:RADIO HEIGHT,METERS))%!d! м)",
      "LanguageDll.12297": "Радиовысотомер (%((A:RADIO HEIGHT,FEET))%!d! фут.)",
      "LanguageDll.12298": "Задатчик высоты принятия решения (%((A:DECISION HEIGHT,METERS))%!d! м)",
      "LanguageDll.12299": "Задатчик высоты принятия решения (%((A:DECISION HEIGHT,FEET))%!d! фут.)",
      "LanguageDll.12300": "Сигнал предупреждения о высоте принятия решения (высота\u00A0— %((A:WARNING LOW HEIGHT,BOOL))%{if}low%{else}ok%{end})",
      "LanguageDll.12304": "Индикатор положения закрылков (закрылки\u00A0— %((A:TRAILING EDGE FLAPS0 LEFT ANGLE,DEGREES) d 0 >)%{if}%!d!° down%{else}up%{end})",
      "LanguageDll.12305": "Рычаг управления закрылками (%((A:FLAPS HANDLE PERCENT,PERCENT))%!d!%%)",
      "LanguageDll.12306": "Индикатор положения закрылков (%((A:TRAILING EDGE FLAPS0 LEFT ANGLE, degrees))%!d!°)",
      "LanguageDll.12307": "Рычаг закрылков (%((A:FLAPS HANDLE PERCENT, percent))%!d!%%)",
      "LanguageDll.12312": "Часы (%((P:LOCAL TIME,HOURS) flr 12 % d 12 r ?)%!d!:%((P:LOCAL TIME,MINUTES) flr 60 %)%!02d!:%((P:LOCAL TIME,SECONDS) flr 60 %)%!02d! %((P:LOCAL TIME,HOURS) 12.0 <)%{if}am%{else}pm%{end})",
      "LanguageDll.12313": "Указатель скорости моделирования (%((P:SIMULATION RATE,NUMBER))%!1.2f!x)",
      "LanguageDll.12320": "Рычаг водяного руля (%((A:WATER RUDDER HANDLE POSITION,PERCENT) 0 >)%{if}down%{else}up%{end})",
      "LanguageDll.12336": "Пожар в моторном отсеке (%1!!%{if}yes!%{else}no%{end})",
      "LanguageDll.12337": "Давление масла (%1!!%{if}low%{else}ok%{end})",
      "LanguageDll.12338": "Генератор (%1!!%{if}off%{else}on%{end})",
      "LanguageDll.12339": "Рычаг аварийного источника питания (%1!!%{if}on%{else}off%{end})",
      "LanguageDll.12340": "Вспомогательный топливный насос (%1!!%{if}on%{else}off%{end})",
      "LanguageDll.12341": "Давление топлива (%1!!%{if}low%{else}ok%{end})",
      "LanguageDll.12342": "Стартёр (%1!!%{if}on%{else}off%{end})",
      "LanguageDll.12343": "Зажигание (%1!!%{if}on%{else}off%{end})",
      "LanguageDll.12344": "Напряжение (%1!!%{if}low%{else}ok%{end})",
      "LanguageDll.12345": "Разрежение в вакуумной системе (%1!!%{if}low%{else}ok%{end})",
      "LanguageDll.12346": "Уровень топлива в резервуаре (%1!!%{if}low%{else}ok%{end})",
      "LanguageDll.12347": "Уровень топлива в левом топливном баке (%1!!%{if}low%{else}ok%{end})",
