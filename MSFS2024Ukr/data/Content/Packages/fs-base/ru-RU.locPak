      "REDBULL.LEADERBOARD_GHOST_DESC": "Выберите время, чтобы увидеть призрачный повтор в игре",
      "REDBULL.MATCH_SETTINGS.FLIGHT_PATH": "Маршрут полёта",
      "REDBULL.MATCH_SETTINGS.GATE_COUNTER": "Счетчик ворот",
      "REDBULL.MATCH_SETTINGS.LAP_COUNTER": "Счетчик кругов",
