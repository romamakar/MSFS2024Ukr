<?xml version="1.0" encoding="utf-8"?>
<Game configVersion="1">
  <Identity Name="Microsoft.Limitless" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" Version="1.8.16.0" />
  <StoreId>9P38D19T7LRV</StoreId>
  <TitleId>604cc91b</TitleId>
  <MSAAppId>23cf167f-8716-4d4c-8dc1-20611e03a087</MSAAppId>
  <!-- PC-only: special option that has been asked by Microsoft (as we are 1PP) on 2024/11/05 -->
  <MSAFullTrust>true</MSAFullTrust>
  <!-- Simplified user sign-in -->
  <AdvancedUserModel>false</AdvancedUserModel>
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="fr-FR" />
    <Resource Language="de-DE" />
    <Resource Language="es-ES" />
    <Resource Language="es-MX" />
    <Resource Language="it-IT" />
    <Resource Language="pl-PL" />
    <Resource Language="pt-PT" />
    <Resource Language="pt-BR" />
    <Resource Language="ru-RU" />
    <Resource Language="nl-NL" />
    <Resource Language="ja-JP" />
    <Resource Language="nb-NO" />
    <Resource Language="fi-FI" />
    <Resource Language="sv-SE" />
    <Resource Language="zh-CN" />
    <Resource Language="ko-KR" />
    <Resource Language="tr-TR" />
  </Resources>
  <ExecutableList>
    <Executable Name="FlightSimulator2024.exe" OverrideDisplayName="ms-resource:AppName" Id="App" Alias="FlightSimulator2024.exe" />
  </ExecutableList>
  <ShellVisuals DefaultDisplayName="Microsoft Flight Simulator 2024" PublisherDisplayName="Microsoft Studios" StoreLogo="StoreLogo.png" Square150x150Logo="Logo.png" Square44x44Logo="SmallLogo.png" Description="Microsoft Flight Simulator 2024" BackgroundColor="#000040" SplashScreenImage="SplashScreen.png" />
  <DesktopRegistration>
    <DependencyList>
      <KnownDependency Name="VC14" />
    </DependencyList>
    <ProcessorArchitecture>x64</ProcessorArchitecture>
    <!-- DEPRECATED <DisableFilesystemWriteVirtualization>true</DisableFilesystemWriteVirtualization> -->
    <!-- DEPRECATED <DisableRegistryWriteVirtualization>true</DisableRegistryWriteVirtualization> -->
    <MultiplayerProtocol>true</MultiplayerProtocol>
    <CustomInstallActions>
      <Folder>InstallUtils</Folder>
      <InstallActionList>
        <InstallAction File="CustomInstaller.exe" Name="KHInstaller" Arguments="/donothing Microsoft.Limitless" />
      </InstallActionList>
      <UninstallActionList>
        <UninstallAction File="CustomInstaller.exe" Name="KHInstaller" Arguments="/clean Microsoft.Limitless" />
      </UninstallActionList>
    </CustomInstallActions>
  </DesktopRegistration>
</Game>