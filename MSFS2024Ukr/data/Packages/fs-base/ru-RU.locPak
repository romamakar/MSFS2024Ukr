      "MENU.SOUND_MUSIC_SELECTION": "ВИБІР МУЗИКИ",
      "MENU.SOUND_MUSIC_SELECTION_DESC": "Виберіть улюблену музику для Microsoft Flight Simulator.",
      "MENU.SOUND_MUSIC_SELECTION_MUS_COLOR_01": "ВАРІАНТ 1",
      "MENU.SOUND_MUSIC_SELECTION_MUS_COLOR_02": "ВАРІАНТ 2",
