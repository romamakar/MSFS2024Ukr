      "LanguageDll.12699": "Регулятор кроку гвинта 3 (%((A:GENERAL ENG3 PROPELLER LEVER POSITION, %) s0 0 >=)%{if}%(l0)%!d!%%%{else}feathered%{end})",
      "LanguageDll.12700": "Регулятор кроку гвинта 4 (%((A:GENERAL ENG4 PROPELLER LEVER POSITION, %) s0 0 >=)%{if}%(l0)%!d!%%%{else}feathered%{end})",
      "LanguageDll.12704": "РУД (%((A:GENERAL ENG1 THROTTLE LEVER POSITION, %) s0 0 <)%{if}reverse %{end}%(l0 abs)%!d!%%)",
      "LanguageDll.12705": "Двигун 1\u00A0— РУД (%((L:EmergencyThrottleInUse, bool) 1 !=)%{if}%((A:GENERAL ENG1 THROTTLE LEVER POSITION, %) s0 0 <)%{end}%(l0 abs)%!",
      "LanguageDll.12706": "Двигун 2\u00A0— РУД (%((A:GENERAL ENG2 THROTTLE LEVER POSITION, %) s0 0 <)%{if}reverse %{end}%(l0 abs)%!d!%%)",
