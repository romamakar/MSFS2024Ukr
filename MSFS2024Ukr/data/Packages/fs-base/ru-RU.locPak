      "REDBULL.HELP.P6RACE_PENALTIES.CATEGORY_PYLON.DESC1_PYLONHIT": "Пiлот зiштовхнувся з орiєнтиром",
      "REDBULL.HELP.P6RACE_PENALTIES.CATEGORY_PYLON.DESC2_THIRDPYLONHIT": "Пiлот зiштовхнувся iз третiм орiєнтиром",
      "REDBULL.HELP.P6RACE_PENALTIES.CATEGORY_PYLON.SUBTITLE1_PYLONHIT": "Зачеплений орiєнтир",
