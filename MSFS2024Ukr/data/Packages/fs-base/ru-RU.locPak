      "LanguageDll.1": "00000409",
      "LanguageDll.10": "Файл Dem4km.bgl відсутній або пошкоджений. Перевстановіть Flight Simulator, щоб відновити чи виправити файл. Гра Flight Simulator буде закрито.",
      "LanguageDll.11": "Файл Seasons.bgl відсутній або пошкоджений. Перевстановіть Flight Simulator, щоб відновити чи виправити файл. Гра Flight Simulator буде закрито.",
      "LanguageDll.12": "Файл Lclookup.bgl відсутній або пошкоджений. Перевстановіть Flight Simulator, щоб відновити чи виправити файл. Гра Flight Simulator буде закрито.",
      "LanguageDll.12289": "Покажчик повітряної швидкості (%((A:AIRSPEED SELECT INDICATED OR TRUE, kilometers/hour))%!d! км/год)",
      "LanguageDll.12290": "Покажчик повітряної швидкості (%((A:AIRSPEED SELECT INDICATED OR TRUE, knots))%!d! вузл.)",
      "LanguageDll.12296": "Радіовисотомір (%((A:RADIO HEIGHT,METERS))%!d! м)",
      "LanguageDll.12297": "Радіовисотомір (%((A:RADIO HEIGHT,FEET))%!d! фут.)",
      "LanguageDll.12298": "Задатчик висоти ухвалення рішення (%((A:DECISION HEIGHT,METERS))%!d! м)",
      "LanguageDll.12299": "Задатчик висоти ухвалення рішення (%((A:DECISION HEIGHT,FEET))%!d! фут.)",
      "LanguageDll.12300": "Сигнал попередження про висоту прийняття рішення (висота — %((A:WARNING LOW HEIGHT,BOOL))%{if}low%{else}ok%{end})",
      "LanguageDll.12304": "Індикатор положення закрилків (закрилки\u00A0— %((A:TRAILING EDGE FLAPS0 LEFT ANGLE,DEGREES) d 0 >)%{if}%!d!° down%{else}up%{end})",
      "LanguageDll.12305": "Важіль керування закрилками (%((A:FLAPS HANDLE PERCENT,PERCENT))%!d!%%)",
      "LanguageDll.12306": "Індикатор положення закрилків (%((A:TRAILING EDGE FLAPS0 LEFT ANGLE, degrees))%!d!°)",
      "LanguageDll.12307": "Важіль закрилків (%((A:FLAPS HANDLE PERCENT, percent))%!d!%%)",
      "LanguageDll.12312": "Годинник (%((P:LOCAL TIME,HOURS) flr 12 % d 12 r ?)%!d!:%((P:LOCAL TIME,MINUTES) flr 60 %)%!02d!:%((P:LOCAL TIME,SECONDS) flr 60 %)%!02d 12.0 <)%{if}am%{else}pm%{end})",
      "LanguageDll.12313": "Вказівник швидкості моделювання (%((P:SIMULATION RATE,NUMBER))%!1.2f!x)",
      "LanguageDll.12320": "Важіль водяного керма (%((A:WATER RUDDER HANDLE POSITION,PERCENT) 0 >)%{if}down%{else}up%{end})",
      "LanguageDll.12336": "Пожежа в моторному відсіку (%1!!%{if}yes!%{else}no%{end})",
      "LanguageDll.12337": "Тиск олії (%1!!%{if}low%{else}ok%{end})",
      "LanguageDll.12338": "Генератор (%1!!%{if}off%{else}on%{end})",
      "LanguageDll.12339": "Важіль аварійного джерела живлення (%1!!%{if}on%{else}off%{end})",
      "LanguageDll.12340": "Допоміжний паливний насос (%1!!%{if}on%{else}off%{end})",
      "LanguageDll.12341": "Тиск палива (%1!!%{if}low%{else}ok%{end})",
      "LanguageDll.12342": "Стартер (%1!!%{if}on%{else}off%{end})",
      "LanguageDll.12343": "Запалювання (%1!!%{if}on%{else}off%{end})",
      "LanguageDll.12344": "Напруга (%1!!%{if}low%{else}ok%{end})",
      "LanguageDll.12345": "Розрідження у вакуумній системі (%1!!%{if}low%{else}ok%{end})",
      "LanguageDll.12346": "Рівень палива в резервуарі (%1!!%{if}low%{else}ok%{end})",
      "LanguageDll.12347": "Рівень палива у лівому паливному баку (%1!!%{if}low%{else}ok%{end})",
      "LanguageDll.12348": "Рівень палива у правому паливному баку (%1!!%{if}low%{else}ok%{end})",
      "LanguageDll.12349": "Резервне електроживлення (%1!!%{if}on%{else}off%{end})",
      "LanguageDll.12350": "Система ПОЗ (%1!!%{if}on%{else}off%{end})",
      "LanguageDll.12351": "Селектори подачі палива (%1!!%{if}not all on%{else}all on%{end})",
      "LanguageDll.12368": "Висотомір (%((A:INDICATED ALTITUDE,METERS))%!d! м)",
      "LanguageDll.12369": "Висотомір (%((A:INDICATED ALTITUDE,FEET))%!d! фут)",
      "LanguageDll.12370": "Висотомір (%((P:UNITS OF MEASURE, ENUM))%{case}%{:2}%((A:INDICATED ALTITUDE,METERS))%!d!, meters%{else}%((A:INDICATED ALTITUDE,FEET))%!d!, feet%{end})",
      "LanguageDll.12371": "Ручка калібрування висотоміра (%((A:KOHLSMAN SETTING HG, inHg))%!1.2f! дюйм. рт. ст.)",
      "LanguageDll.12372": "Ручка калібрування висотоміра (%((A:KOHLSMAN SETTING HG, mbar))%!d! мбар)",
      "LanguageDll.12373": "Ручка калібрування висотоміра (%((A:KOHLSMAN SETTING HG:2, inHg))%!1.2f! дюйм. рт. ст.)",
      "LanguageDll.12374": "Ручка калібрування висотоміра (%((A:KOHLSMAN SETTING HG:2, mbar))%!d! мбар)",
      "LanguageDll.12384": "Основний перемикач автопілота (%((A:AUTOPILOT MASTER,BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12385": "Перемикач директорного пілотажного приладу (%((A:AUTOPILOT FLIGHT DIRECTOR ACTIVE,BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12386": "Перемикач автомата стабілізації по крену (%((A:AUTOPILOT WING LEVELER, BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12387": "Перемикач автомата повітряної швидкості приладів (%((A:AUTOPILOT AIRSPEED HOLD, BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12388": "Перемикач автомата зворотного променя курсового маяка (%((A:AUTOPILOT BACKCOURSE HOLD, BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12389": "Перемикач автомата заходу (%((A:AUTOPILOT APPROACH HOLD, BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12390": "Перемикач демпфера нишпорення (%((A:AUTOPILOT YAW DAMPER, BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12391": "Перемикач утримання маршруту (%((A:AUTOPILOT NAV1 LOCK, BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12392": "Перемикач утримання курсу (%((A:AUTOPILOT HEADING LOCK, BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12393": "Задатчик утримання курсу (%((A:AUTOPILOT HEADING LOCK DIR, degrees) flr 360 % d 0 == if{ 360 })%!d!°)",
      "LanguageDll.12394": "Перемикач автомата вертикальної швидкості (%((A:AUTOPILOT VERTICAL HOLD, BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12395": "Селектор стабілізації вертикальної швидкості (%((A:AUTOPILOT VERTICAL HOLD VAR, feet per minute))%!d! фут/хв)",
      "LanguageDll.12396": "Селектор стабілізації вертикальної швидкості (%((A:AUTOPILOT VERTICAL HOLD VAR, m/s))%!d! м/с)",
      "LanguageDll.12397": "Перемикач автомата висоти (%((A:AUTOPILOT ALTITUDE LOCK, BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12398": "Задатчик автомата висоти (% ((A: AUTOPILOT ALTITUDE LOCK VAR, feet)) %! d! фут.)",
      "LanguageDll.12399": "Задатчик автомата висоти (%((A:AUTOPILOT ALTITUDE LOCK VAR, meters))%!d! м)",
      "LanguageDll.12400": "Перемикач автомата швидкості (%((A:AUTOPILOT AIRSPEED HOLD, BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12401": "Задатчик автомата швидкості (%((A:AUTOPILOT AIRSPEED HOLD VAR, knots))%!d! вузл.)",
      "LanguageDll.12402": "Задатчик автомата швидкості (%((A:AUTOPILOT AIRSPEED HOLD VAR, kilometers/hour))%!d! км/год)",
      "LanguageDll.12403": "Перемикач автомата тяги (%((A:AUTOPILOT THROTTLE ARM, BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12404": "Перемикач стабілізації числа Маха (%((A:AUTOPILOT MACH HOLD, BOOL))%{if}on%{else}off%{end})",
      "LanguageDll.12405": "Задатчик стабілізації числа Маха (%((A:AUTOPILOT MACH HOLD VAR, mach))%!1.2f! M)",
      "LanguageDll.12416": "Індикатор розрідження (%((A:SUCTION PRESSURE, mbar))%!d! мбар)",
      "LanguageDll.12417": "Індикатор розрідження (%((A:SUCTION PRESSURE, inHg))%!1.1f! дюйм. рт. ст.)",
      "LanguageDll.12432": "Покажчик повороту та ковзання (%((A:DELTA HEADING RATE, % degrees per second) s0 abs)%!.1f!°/с\u00A0— %(l0 0 >)%{if}right%{else}left%{end})",
      "LanguageDll.12434": "Вказівник просторового положення %((A:ATTITUDE INDICATOR BANK DEGREES, degrees) s0 abs s1)%((A:ATTITUDE INDICATOR PITCH DEGREES, degrees) s2 abs s3)%(l1 l3 + 0.99 >)%{if} (%{end}%(l %!d!° Left%{lse}%(l1 l0 -0.99 <)%{if}Bank %!d!° Right%{end}%{end}%(l3 0.99 >)%{if}%(l1 0.99 >)%{if}, %{end}%{end}%(l3 l2 0.99 >) Down%{else}%(l3 l2 -0.99 <)%{if}Pitch %!d!° Up%{end}%{end}%(l1 l3 + 0.99 >)%{if} )%{end}",
      "LanguageDll.12435": "Вказівник просторового положення %((A:ATTITUDE INDICATOR BANK DEGREES:2, degrees) s0 abs s1)%((A:ATTITUDE INDICATOR PITCH DEGREES:2, degrees) s2 abs s3)%(l1 l3 + 0.99 >)%{if} (%{end %!d!° Left%{lse}%(l1 l0 -0.99 <)%{if}Bank %!d!° Right%{end}%{end}%(l3 0.99 >)%{if}%(l1 0.99 >)%{if}, %{end}%{end}%(l3 l2 0.99 >) Down%{else}%(l3 l2 -0.99 <)%{if}Pitch %!d!° Up%{end}%{end}%(l1 l3 + 0.99 >)%{if} )%{end}",
      "LanguageDll.12436": "Плановий навігаційний прилад (курс %((A:PLANE HEADING DEGREES GYRO, degrees))%!d!°, шляховий кут %((A:NAV1 OBS, degrees))%!d!°)",
      "LanguageDll.12440": "Покажчик вертикальної швидкості (%((A:VERTICAL SPEED, m/s))%!d! м/с)",
      "LanguageDll.12441": "Покажчик вертикальної швидкості (%((A:VERTICAL SPEED, feet per minute))%!d! фут/хв)",
      "LanguageDll.12448": "Тиск наддуву (%((A:ENG1 MANIFOLD PRESSURE, inHg))%!1.1f! дюйм. рт. ст.)",
