      "LanguageDll.12417": "Iндикатор розрiдження (%((A:SUCTION PRESSURE, inHg))%!1.1f! дюйм. рт. ст.)",
      "LanguageDll.12432": "Покажчик повороту та ковзання (%((A:DELTA HEADING RATE, % degrees per second) s0 abs)%!.1f!°/с\u00A0— %(l0 0 >)%{if}right%{else}left%{end})",
      "LanguageDll.12434": "Вказiвник просторового положення %((A:ATTITUDE INDICATOR BANK DEGREES, degrees) s0 abs s1)%((A:ATTITUDE INDICATOR PITCH DEGREES, degrees) s2 abs s3)%(l1 l3 + 0.99 >)%{if} (%{end}%(l %!d!° Left%{lse}%(l1 l0 -0.99 <)%{if}Bank %!d!° Right%{end}%{end}%(l3 0.99 >)%{if}%(l1 0.99 >)%{if}, %{end}%{end}%(l3 l2 0.99 >) Down%{else}%(l3 l2 -0.99 <)%{if}Pitch %!d!° Up%{end}%{end}%(l1 l3 + 0.99 >)%{if} )%{end}",
      "LanguageDll.12435": "Вказiвник просторового положення %((A:ATTITUDE INDICATOR BANK DEGREES:2, degrees) s0 abs s1)%((A:ATTITUDE INDICATOR PITCH DEGREES:2, degrees) s2 abs s3)%(l1 l3 + 0.99 >)%{if} (%{end %!d!° Left%{lse}%(l1 l0 -0.99 <)%{if}Bank %!d!° Right%{end}%{end}%(l3 0.99 >)%{if}%(l1 0.99 >)%{if}, %{end}%{end}%(l3 l2 0.99 >) Down%{else}%(l3 l2 -0.99 <)%{if}Pitch %!d!° Up%{end}%{end}%(l1 l3 + 0.99 >)%{if} )%{end}",
      "LanguageDll.12436": "Плановий навiгацiйний прилад (курс %((A:PLANE HEADING DEGREES GYRO, degrees))%!d!°, шляховий кут %((A:NAV1 OBS, degrees))%!d!°)",
