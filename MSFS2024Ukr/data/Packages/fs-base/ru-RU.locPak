      "LanguageDll.12588": "Штурвальчик тримера керма напряму (рицання) (%((A:RUDDER TRIM PCT, percent))%!d!%%)",
      "LanguageDll.12592": "Індикатор положення шасі (%(0 1 2 (A:GEAR LEFT POSITION,%) s0 99 < ? l0 1 < ? 0 1 2 (A:GEAR CENTER POSITION,%) s0 99 < ? l0 1 < ? 0 1 2 ? + +)%{case}%{:0}up%{:6}down%{else}in transition%{end})",
      "LanguageDll.12593": "Важіль збирання шасі (%((A:GEAR HANDLE POSITION, percent) 50 <)%{if}up%{else}down%{end})",
      "LanguageDll.12608": "Амперметр",
      "LanguageDll.12624": "Панель керування звуком (передача\u00A0— %((A:COM1 TRANSMIT, BOOL))%{if}Com 1%{else}%((A:COM2 TRANSMIT, BOOL))%{if}Com 2%{else}None%{end}%{end}, прийом\u00A0— %((A:COM RECIEVE ALL, BOOL))%{if}BOTH%{else}%((A:COM1 TRANSMIT, BOOL))%{if}Com 1%{else}%((A:COM2 TRANSMIT, BOOL))%{if}Com 2%{else}None%{end}%{end}%{end})",
      "LanguageDll.12640": "Зв'язкова радіостанція (Com 1, активно\u00A0— %((A:COM1 ACTIVE FREQUENCY, MHz))%!07.3f! МГц, очікування\u00A0— %((A:COM1 STANDBY FREQUENCY, MHz))%!07.3f! МГц)",
      "LanguageDll.12641": "Зв'язкова радіостанція (Com 2, активно\u00A0— %((A:COM2 ACTIVE FREQUENCY, MHz))%!07.3f! МГц, очікування\u00A0— %((A:COM2 STANDBY FREQUENCY, MHz))%!07.3f! МГц)",
      "LanguageDll.12648": "Навігаційна радіостанція (Nav 1, активно\u00A0— %((A:NAV1 ACTIVE FREQUENCY, MHz))%!07.3f! МГц, очікування\u00A0— %((A:NAV1 STANDBY FREQUENCY, MHz))%!07.3f! МГц)",
      "LanguageDll.12649": "Навігаційна радіостанція (Nav 2, активно\u00A0— %((A:NAV2 ACTIVE FREQUENCY, MHz))%!07.3f! МГц, очікування\u00A0— %((A:NAV2 STANDBY FREQUENCY, MHz))%!07.3f! МГц)",
      "LanguageDll.12656": "Автоматичний радіокомпас (частота\u00A0% ((A:ADF 1 ACTIVE FREQUENCY, KHz))%!06.1f! КГц)",
      "LanguageDll.12664": "Всеспрямований далекомірний радіомаяк (DME Nav %((A:NAV1 DME, nmiles) 0 >=)%{if}, %((A:NAV1 DME, nmiles))%!1.1f! nm, %((A:NAV1 DMESPEED, knots))%!d!",
      "LanguageDll.12665": "Всеспрямований далекомірний радіомаяк (DME Nav %((A:NAV1 DME, nmiles) 0 >=)%{if}, %((A:NAV1 DME, kilometer))%!1.1f! км, %((A:NAV1 DMESPEED, kilometer/hour))%!d! km/h%{",
      "LanguageDll.12666": "Всеспрямований далекомірний радіомаяк (DME Nav %((A:NAV1 DME, nmiles) 0 >=)%{if}, %((A:NAV1 DME, nmiles) s0)%!1.1f! nm, %((A:NAV1 DMESPEED, knots) s1)%!d!d!d! min%{end})",
      "LanguageDll.12667": "Всеспрямований далекомірний радіомаяк (DME Nav %((A:NAV1 DME, nmiles) 0 >=)%{if}, %((A:NAV1 DME, kilometer) s0)%!1.1f! км, %((A:NAV1 DMESPEED, kilometer/hour) s1)%! min%{end})",
      "LanguageDll.12668": "Вибір DME Nav 1\u00A0/ Nav 2",
      "LanguageDll.12672": "Відповідач (код\u00A0— %((A:TRANSPONDER1 CODE, BCO16) sp0)%(l0 12 >> 15 &)%!d!%(l0 8 >> 15 &)%!d!%(l0 4 >> 15 &)%!d!%(l0 15 &)%!d!)",
      "LanguageDll.12688": "Регулятор суміші (%((A:GENERAL ENG1 MIXTURE LEVER POSITION, %) s0 0 >)%{if}%(l0)%!d!%%%{else}cut%{end})",
      "LanguageDll.12689": "Регулятор суміші (%((A:GENERAL ENG1 MIXTURE LEVER POSITION, %) s0 0 >)%{if}%(l0)%!d!%%%{else}cut%{end})",
      "LanguageDll.12690": "Двигун 2\u00A0— регулятор суміші (%((A:GENERAL ENG2 MIXTURE LEVER POSITION, %) s0 0 >)%{if}%(l0)%!d!%%%{else}cut%{end})",
      "LanguageDll.12691": "Двигун 3\u00A0— регулятор суміші (%((A:GENERAL ENG3 MIXTURE LEVER POSITION, %) s0 0 >)%{if}%(l0)%!d!%%%{else}cut%{end})",
      "LanguageDll.12692": "Двигун 4\u00A0— регулятор суміші (%((A:GENERAL ENG4 MIXTURE LEVER POSITION, %) s0 0 >)%{if}%(l0)%!d!%%%{else}cut%{end})",
      "LanguageDll.12696": "Регулятор кроку гвинта (%((A:GENERAL ENG1 PROPELLER LEVER POSITION, %) s0 0 >=)%{if}%(l0)%!d!%%%{else}feathered%{end})",
