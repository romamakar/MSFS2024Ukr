      "PrivateCharter.VO__MAIN_CHARACTER1__PrivateCharter__Generic__ArrivedHappy__010__M__Generic__1_2": "Ми вже прилетiли?",
      "PrivateCharter.VO__MAIN_CHARACTER1__PrivateCharter__Generic__ArrivedHappy__010__M__Generic__2": "Ми вже прилетiли? Чудово!",
