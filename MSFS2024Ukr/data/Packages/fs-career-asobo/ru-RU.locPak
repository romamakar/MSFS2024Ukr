      "NPCIngameLabel.Skydive_Pilot_Generic_Generic_Mission_Giver_Male": "[Generated/Npc/Mission_Giver/FirstName] [Generated/Npc/Mission_Giver/LastName] — [Generated/Npc/Mission_Giver/Hierarchy]",
      "NPCIngameLabel.Skydive_Pilot_Generic_Generic_Skydiver_Female": "[Generated/Npc/Skydiver/FirstName] — парашутистка",
      "NPCIngameLabel.Skydive_Pilot_Generic_Generic_Skydiver_Male": "[Generated/Npc/Skydiver/FirstName] — парашутист",
      "NPCIngameLabel.Skydive_Pilot_Generic_Generic_Tech_Director_Female": "[Generated/Npc/Tech_Director/FirstName] - головний інженер",
      "NPCIngameLabel.Skydive_Pilot_Generic_Generic_Tech_Director_Male": "[Generated/Npc/Tech_Director/FirstName] - головний інженер",
      "NPCIngameLabel.Tour_Generic_Generic_Flight_Coordinator_Female": "[Generated/Npc/Flight_Coordinator/FirstName] – координатор польотів",
      "NPCIngameLabel.Tour_Generic_Generic_Flight_Coordinator_Male": "[Generated/Npc/Flight_Coordinator/FirstName] – координатор польотів",
      "NPCIngameLabel.Tour_Generic_Generic_Mission_Giver_Female": "[Generated/Npc/Mission_Giver/FirstName] [Generated/Npc/Mission_Giver/LastName] — [Generated/Npc/Mission_Giver/Hierarchy]",
      "NPCIngameLabel.Tour_Generic_Generic_Mission_Giver_Male": "[Generated/Npc/Mission_Giver/FirstName] [Generated/Npc/Mission_Giver/LastName] — [Generated/Npc/Mission_Giver/Hierarchy]",
      "NPCIngameLabel.Tour_Generic_Generic_Passenger_Female": "[Generated/Npc/Passenger/FirstName] – ваш пасажир",
      "NPCIngameLabel.Tour_Generic_Generic_Passenger_Male": "[Generated/Npc/Passenger/FirstName] – ваш пасажир",
      "NPCIngameLabel.Tour_Generic_Generic_Relative_Female": "[Generated/Npc/Relative/FirstName] – ваш пасажир",
      "NPCIngameLabel.Tour_Generic_Generic_Relative_Male": "[Generated/Npc/Relative/FirstName] – ваш пасажир",
      "NPCIngameLabel.Tour_Generic_Proposal_Relative_Female": "[Generated/Npc/Relative/FirstName] – ваш пасажир",
      "NPCIngameLabel.Tour_Generic_Proposal_Relative_Male": "[Generated/Npc/Relative/FirstName] – ваш пасажир",
      "PASSENGER_TRANSPORT.ACTIVITY.TITLE": "Пасажирський транспортний",
      "PASSENGER_TRANSPORT.SPECIALIZATION.AIRLINER.DESCR": "Виконайте дитячу мрію стати лінійним пілотом та перевозіть великі групи пасажирів. Досвідченому пілоту знадобиться вміння керувати великим повітряним судном та забезпечувати пасажирам комфорт та безпеку на кожному відрізку колії. У світі комерційної авіації кожен рейс – як місцевий, так і міжнародний – принесе вам чимало випробувань та обов'язково запам'ятається надовго.",
      "PASSENGER_TRANSPORT.SPECIALIZATION.AIRLINER.TITLE": "Перевезення пасажирів - авіалінія",
      "PASSENGER_TRANSPORT.SPECIALIZATION.MIDSIZE.DESCR": "Перейдіть на новий рівень, отримавши доступ до регіональних рейсів, та заручіться за допомогою другого пілота. Тут вам доведеться керувати більшим апаратом і взаємодіяти з помічником, щоб ефективно та безпечно доставити літак до пункту призначення. Пілоти пасажирських рейсів повинні стати ефективною командою, яка повинна стежити за навігаційними приладами, керувати системами літака та приймати найважливіші рішення у процесі польоту.",
      "PASSENGER_TRANSPORT.SPECIALIZATION.MIDSIZE.TITLE": "Перевезення пасажирів - середній літак",
      "PASSENGER_TRANSPORT.SPECIALIZATION.ROTORCRAFT.DESCR": "Перевозіть пасажирів на борту вертольота — з міста до міста, на туристичні об'єкти та іншими різноманітними маршрутами. Для цієї професії необхідні чудові навички пілотажу та особлива льотна підготовка, а досягнуть успіху лише пілоти, які зможуть забезпечити пасажирам комфорт та безпеку на кожному відрізку колії.",
      "PASSENGER_TRANSPORT.SPECIALIZATION.ROTORCRAFT.FILTER": "Перевезення пасажирів - гелікоптери",
      "PASSENGER_TRANSPORT.SPECIALIZATION.ROTORCRAFT.TITLE": "Пасажирський транспортний",
      "PASSENGER_TRANSPORT.SPECIALIZATION.SMALL.DESCR": "Ознайомтеся з азами перевезення пасажирів на місцевих рейсах. Від пілота потрібна стресостійкість та вміння швидко приймати рішення.",
      "PASSENGER_TRANSPORT.SPECIALIZATION.SMALL.TITLE": "Перевезення пасажирів - невеликий літак",
      "PRIVATE_CHARTER.ACTIVITY.TITLE": "Чартерні послуги",
      "PRIVATE_CHARTER.SPECIALIZATION.AIRLINER.DESCR": "Готується великий захід. Ваше завдання – доставити на нього велику кількість гостей. А члени екіпажу подбають про ваших пасажирів, щоби надовго запам'ятали цей політ.",
      "PRIVATE_CHARTER.SPECIALIZATION.AIRLINER.TITLE": "Чартерні послуги - VIP-авіалайнер",
      "PRIVATE_CHARTER.SPECIALIZATION.MIDSIZE.DESCR": "Ваше завдання — разом із другим пілотом доставляти особливих пасажирів (наприклад, журналістів чи стилістів) на ексклюзивні заходи, що збігаються із заходами реального світу. Зробіть так, щоб ваші клієнти запам'ятали свій політ і станьте господарем неба.",
      "PRIVATE_CHARTER.SPECIALIZATION.MIDSIZE.TITLE": "Чартерні послуги - VIP",
      "PRIVATE_CHARTER.SPECIALIZATION.ROTORCRAFT.DESCR": "Пілот VIP-вертольота відповідає за безпеку та комфорт найважливіших клієнтів: політиків, знаменитостей та великих підприємців. Ця професія вимагає високого рівня професіоналізму, обачності, уміння швидко пристосовуватися до нових обставин, уважно обслуговувати всіх пасажирів та не розкривати конфіденційну інформацію.",
      "PRIVATE_CHARTER.SPECIALIZATION.ROTORCRAFT.TITLE": "Чартерні послуги - приватні",
      "PRIVATE_CHARTER.SPECIALIZATION.SMALL.DESCR": "Вирушайте в чартерний рейс і перевозьте мандрівників по всьому світу. Нехай ваші пасажири подивляться на визначні пам'ятки і помилуються чудовими краєвидами з висоти пташиного польоту — станьте їх ангелом-охоронцем та провідником чудес світу.",
      "PRIVATE_CHARTER.SPECIALIZATION.SMALL.TITLE": "Чартерні послуги - приватні",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__AnnouncementClearance__010__M__Generic__1": "Ми очікуємо на дозвіл на зліт від диспетчерської і скоро вилетимо. Дякуємо за виявлене терпіння. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__AnnouncementSecurity__020__M__Generic__1": "Наразі наші бортпровідники проведуть демонстрацію аварійно-рятувального обладнання нашого літального апарату. Будь ласка, уважно її подивіться.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__AnnouncementTechReminder__010__M__Generic__2": "Для вашої безпеки переконливо просимо всіх пасажирів вимкнути мобільні телефони та інші електронні пристрої під час висоти. Дякую. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__AnnouncementTechReminder__010__M__Generic__3": "Переведіть мобільні електронні пристрої в режим польоту. Ви можете увімкнути їх після прибуття до пункту призначення. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__ApproachBelt__010__M__Generic__1": "Скоро ми здійснимо посадку. Переконайтеся, що ремінь безпеки надійно пристебнутий. Дякую за увагу.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__AtcThunderstormSevere__020__M__Generic__1": "Прийнято, дякую. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__AtcThunderstormSevere__020__M__Generic__2": "Прийнято, чекаємо. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__AtcThunderstormSevere__020__M__Generic__3": "Я повідомлю команду.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__BeforeDeparture__020__M__Generic__4": "Двері зачинені.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__BoardingPlaneClearance__010__M__Generic__1": "Ми готові до посадки пасажирів. Чекаємо на ваші вказівки. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__BoardingPlaneClearance__010__M__Generic__2": "Пасажири готові до посадки. Чекаємо на дозвіл. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__BoardingPlaneClearance__010__M__Generic__3": "Ми готові до посадки пасажирів. Чекаємо вашого дозволу. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__BoardingPlaneClearance__010__M__Generic__4": "До посадки готові, чекаємо на ваші вказівки. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__BoardingPlaneClearance__010__M__Generic__5": "Ми готові до посадки. Дайте нам знати, коли починати. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__BoardingPlaneClearance__030__M__Generic__1": "Посадка закінчена, капітан.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__BoardingPlaneClearance__030__M__Generic__2": "Посадка завершена, капітан.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__BoardingPlaneClearance__030__M__Generic__3": "Усі пасажири на борту, капітане.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__BoardingPlaneClearance__030__M__Generic__4": "Посадка закінчена, капітан.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__BoardingPlaneClearance__030__M__Generic__5": "Посадка закінчена, капітан.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__CateringCharge__010__M__Generic__1": "Йде завантаження бортового живлення.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__CateringCharge__010__M__Generic__2": "Йде завантаження бортового живлення. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__CateringCharge__010__M__Generic__3": "Йде завантаження бортового живлення. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__CateringCharge__020__M__Generic__1": "Роздачу бортового живлення завершено.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__CateringCharge__020__M__Generic__2": "Бортове харчування готове. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__CateringCharge__020__M__Generic__3": "Капітан, кількість живлення на борту: {FS:Number_Passengers}",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__CruiseBar__010__M__Generic__1": "Протягом польоту вам буде доступний бар, а також чай та кава. Якщо вам потрібна будь-яка допомога, будь ласка, звертайтесь. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__CruiseCattering__010__M__Generic__1": "Капітане, ми готові подавати обід. Запрошую дозвіл на початок обслуговування на борту. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__CruiseCattering__030__M__Generic__3": "Шановні пасажири! Нині наша команда подасть бортове харчування. Будь ласка, приготуйте відкидний столик. Дякую!",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__CruiseDuty__010__M__Generic__1": "До уваги пасажирів: незабаром вам буде запропоновано холодні та гарячі напої, а також закуски. Дякую. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__CruiseMag__010__M__Generic__1": "У кишені сидіння перед вами ви знайдете безкоштовні випуски свіжих газет - вони скрасять політ. Можете забрати їх із собою, коли залишатимете борт.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__EndOk__010__M__Generic__1": "Як чудово бути з вами в одній команді! Сподіваюся, скоро зустрінемося. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__EndOk__010__M__Generic__3": "Ну нарешті цей політ закінчився. Я абсолютно без сил. Поки займуся прибиранням, а потім побачимось! ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight1__010__M__Generic__1": "Деякі пасажири скаржаться, що літальний апарат буквально смикається у повітрі.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight1__010__M__Generic__2": "Капітан, треба сказати, пасажири незадоволені через турбулентність.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight1__010__M__Generic__3": "Капітане, вибачте, що заважаю, але пасажири скаржаться на турбулентність. Думаю, вам слід знати про це.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight1__010__M__Generic__4": "Капітан, надходять скарги від деяких пасажирів. Це через трясіння.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight1__010__M__Generic__5": "Хочу попередити вас дещо, капітане. Деякі пасажири незадоволені тряскою. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight2__010__M__Generic__1": "Капітане, у мене тут новини. Деяким пасажиром недобре. Швидше за все, через турбулентність. Чи можемо їм чимось допомогти?",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight2__010__M__Generic__2": "Вибачте, що знову турбую вас, капітане. Пасажири погано почуваються. Ви можете зробити їхній політ більш комфортним?",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight2__010__M__Generic__3": "Капітане, вибачте, що знову вас турбую. Деякі пасажири мають дискомфорт. Думаю, вам буде важливим це знати.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight2__010__M__Generic__4": "Говорять, одному з пасажирів дуже погано. Чи можете ви чимось допомогти? ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight2__010__M__Generic__5": "Пасажири дуже незадоволені. Одному з них погано від трясіння. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight3__010__M__Generic__1": "Деяким пасажирам недобре. Швидше за все, через трясіння. Ви можете щось із цим зробити? ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight3__010__M__Generic__2": "Вибачте, що знову вас турбую. Гостей захитує. Можете щось із цим зробити? ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight3__010__M__Generic__3": "Вибачте, що знову вас турбую. Деякі пасажири скаржаться на надмірну тряску. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight3__010__M__Generic__4": "Капітан, деяких пасажирів нудить. Чи можемо летіти спокійніше? ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight3__010__M__Generic__5": "Деяким пасажирам погано від трясіння, і вони дуже незадоволені. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight4__010__M__Generic__1": "Деяким пасажирам недобре. Швидше за все, через трясіння. Чи можна щось із цим зробити? ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight4__010__M__Generic__2": "Вибачте, що знову турбую вас, капітане. Пасажири погано почуваються через турбулентність. Ви можете щось зробити? ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight4__010__M__Generic__3": "Вибачте, що турбую, але деяким пасажирам погано. Ми можемо щось зробити? ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight4__010__M__Generic__4": "Деяких пасажирів нудить. Чи можна щось зробити з турбулентністю? ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight4__010__M__Generic__5": "Деяким пасажирам погано від трясіння, і вони вкрай незадоволені.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__HazardSickpassengerNotok__010__M__Generic__1": "Капітан, пасажиру стає гірше. Лікар турбується про його стан. Що робитимемо?",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__HazardSickpassengerOk__010__M__Generic__1": "Хворому пасажирові стало набагато краще. Все гаразд. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__HazardSickpassenger__010__M__Generic__1": "Капітане, комусь у салоні погано. Я зроблю оголошення по гучномовному зв'язку і триматиму вас в курсі. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__HazardSickpassenger__010__M__Generic__2": "На борту хворий пасажир. Ми спілкуємося з лікарем з відеозв'язку, щоб той оцінив його стан. Триматиму вас в курсі. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__LuggageCharge__010__M__Generic__1": "Завантаження багажу. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__LuggageCharge__010__M__Generic__2": "Починаємо навантаження багажу. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__LuggageCharge__010__M__Generic__3": "Йде навантаження багажу.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__LuggageCharge__020__M__Generic__1": "Завантаження багажу завершено.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__LuggageCharge__020__M__Generic__2": "Весь багаж на борту. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__LuggageCharge__020__M__Generic__3": "Завантаження багажу завершено. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__Refueling__010__M__Generic__1": "Йде дозаправка. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__Refueling__010__M__Generic__2": "Дозаправлення розпочато. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__Refueling__010__M__Generic__3": "Капітан, йде завантаження палива. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__Refueling__020__M__Generic__1": "Заправка закінчена. ",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__Refueling__020__M__Generic__2": "Дозаправлення закінчено. Палива на борту: {S:Fuel_Total_Quantity:Volume}.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__Refueling__020__M__Generic__3": "Дозаправлення завершено.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__TourismGuideAskGive__010__M__Generic__2": "Є кілька варіантів, але я можу порекомендувати цей посібник, написаний компанією {FS:Organization_Name} для наших гостей. Чи не пошкодуєте!",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__TourismGuideAsk__020__M__Generic__1": "Звичайно, дозвольте, я заберу це для вас.",
      "PrivateCharter.VO__CABIN1__PrivateCharter__PlaneCabinCrew__TourismGuideAsk__020__M__Generic__2": "Звісно!",
      "PrivateCharter.VO__CABIN2__PrivateCharter__PlaneCabinCrew__AnnouncementSecurity__020__M__Generic__1": "Наразі наші бортпровідники проведуть демонстрацію аварійно-рятувального обладнання нашого літального апарату. Будь ласка, уважно її подивіться.",
      "PrivateCharter.VO__CABIN2__PrivateCharter__PlaneCabinCrew__AnnouncementTechReminder__010__M__Generic__2": "Для вашої безпеки просимо всіх пасажирів вимкнути мобільні телефони та інші електронні пристрої до початку польоту. Дякую.",
      "PrivateCharter.VO__CABIN2__PrivateCharter__PlaneCabinCrew__AnnouncementTechReminder__010__M__Generic__3": "На час польоту переведіть мобільні електронні пристрої в режим польоту. Ви можете увімкнути їх після спеціального оповіщення після прибуття.",
      "PrivateCharter.VO__CABIN2__PrivateCharter__PlaneCabinCrew__CruiseBar__010__M__Generic__1": "Протягом польоту вам буде доступний бар, а також чай та кава. Якщо вам потрібна будь-яка допомога, будь ласка, зв'яжіться з нашими бортпровідниками.\u00A0",
      "PrivateCharter.VO__CABIN2__PrivateCharter__PlaneCabinCrew__CruiseCattering__030__M__Generic__3": "Шановні пасажири. Нині наша команда почне подавати бортове харчування. Будь ласка, висуньте відкидний столик. Приємного польоту!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BarometerReminder__010__M__Generic__1": "Ми тільки що пройшли позначку 18\u00A0000 футів, тому не забудьте переключити барометр на стандартний тиск. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BarometerReminder__010__M__Generic__2": "Капітане, ми щойно пройшли позначку 18 000 футів — настав час повернути висотомір у стандартний режим. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BarometerUnderReminder__010__M__Generic__1": "Ми щойно пройшли позначку нижче 18 000 футів. Не забудьте переключити барометр на тиск над рівнем моря (QNH).",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BarometerUnderReminder__010__M__Generic__2": "Ми знаходимося нижче 18\u00A0000 футів - не забудьте переключити висотомір на тиск над рівнем моря (QNH).",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforeflightStart__010__M__Generic__1": "Двигун запущено. Тепер перевіримо вогні. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforeflightStart__010__M__Generic__2": "Двигун у порядку. Перевірка вогню маяка. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforeflightStart__010__M__Generic__3": "Двигун увімкнено. Перевірте вогні. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartBeaconOff__010__M__Generic__1": "Сигнальний маяк вимкнено. Будь ласка, увімкніть його. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartBeaconOff__010__M__Generic__2": "Ми забули про сигнальні вогні!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartBeaconOff__010__M__Generic__3": "Спочатку слід подати сигнал про нашу присутність, і лише потім запускати двигун. Давайте увімкнемо сигнальний маяк. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartBeacon__010__M__Generic__1": "Маяк увімкнено.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartBeacon__010__M__Generic__2": "З сигнальним маяком все гаразд. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartBeacon__010__M__Generic__3": "Вогонь маяка ввімкнено. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartLandingLightOk__010__M__Generic__1": "Перевірка посадкових фар. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartLandingLightOk__010__M__Generic__2": "Дозвіл на включення посадкових фар. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartLandingLightOk__010__M__Generic__3": "Посадочні фари у порядку. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartLandingLightTurnOn__010__M__Generic__1": "Будь ласка, увімкніть фари. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartLandingLightTurnOn__010__M__Generic__2": "Капітан, необхідно включити посадкові фари. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartLandingLightTurnOn__010__M__Generic__3": "Будь ласка, увімкніть посадочні фари. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartLandingLight__010__M__Generic__1": "Перевірка посадкових фар. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartLandingLight__010__M__Generic__2": "Давайте перевіримо посадочні фари. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartLandingLight__010__M__Generic__3": "Посадочні фари?",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartNavLightForgot__010__M__Generic__1": "Ми забули увімкнути навігаційні вогні.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartNavLightForgot__010__M__Generic__2": "Навігаційні вогні досі вимкнені. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartNavLightForgot__010__M__Generic__3": "Ми не можемо продовжувати з вимкненими навігаційними вогнями. Увімкніть їх! ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartNavLightOk__010__M__Generic__1": "Навігаційні вогні включені. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartNavLightOk__010__M__Generic__2": "Навігаційні вогні у порядку. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartNavLightOk__010__M__Generic__3": "Навігаційні вогні у нормі. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartNavLight__010__M__Generic__1": "Перевірка навігаційних вогнів. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartNavLight__010__M__Generic__2": "Тепер – навігаційні вогні. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartNavLight__010__M__Generic__3": "Переходимо до навігаційних вогнів. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartQuickCheck__010__M__Generic__1": "Давайте завершимо передпольотні перевірки перед зльотом. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartQuickCheck__010__M__Generic__2": "Давайте закінчимо з передпольотними перевірками. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartQuickCheck__010__M__Generic__3": "Давайте пробіжимося нашими передполітними перевірками.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartTaxiLightOff__010__M__Generic__1": "Капітан, необхідно увімкнути рульові фари. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartTaxiLightOff__010__M__Generic__2": "Рульові фари вимкнено. Будь ласка, увімкніть їх. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartTaxiLightOff__010__M__Generic__3": "Увімкніть рульові фари. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartTaxiLightOk__010__M__Generic__1": "Перевірка руліжних фар: увімкнено. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartTaxiLightOk__010__M__Generic__2": "Рульова фара в порядку. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartTaxiLightOk__010__M__Generic__3": "Дозвіл на включення рульових фар. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartTaxiLightTurnOn__010__M__Generic__1": "Перед злетом необхідно вимкнути рульові фари. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartTaxiLightTurnOn__010__M__Generic__2": "Чекаю, поки ви увімкнете руліжні фари. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartTaxiLightTurnOn__010__M__Generic__3": "Перед злетом руліжні фари повинні бути увімкнені. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartTaxiLight__010__M__Generic__1": "Перевірка рульової фари.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartTaxiLight__010__M__Generic__2": "Давайте перевіримо рульові фари. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__BeforestartTaxiLight__010__M__Generic__3": "Увімкніть руліжні фари, будь ласка. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__NotWell1__010__M__Generic__1": "Все гаразд, капітане? Ви припустилися кількох промахів. Якщо потрібно, звертайтесь до мене за допомогою!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__NotWell1__010__M__Generic__2": "У вас все вийде. У вас достатньо досвіду.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__NotWell1__010__M__Generic__3": "Продовжуйте так само! Зосередьтеся, і у вас все вийде! ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__NotWell2__010__M__Generic__1": "Не турбуйтеся, у всіх бувають невдалі дні. Покладіться на мене, капітане!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__NotWell2__010__M__Generic__2": "Щось ви на себе не схожі. Добре, що ви не один. Можете на мене покластись!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__NotWell2__010__M__Generic__3": "Сьогодні точно не ваш день. Зосередьтеся! У вас все вийде, капітане!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__NotWell3__010__M__Generic__1": "Зберіться! Стільки помилок це на вас зовсім не схоже! ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__NotWell3__010__M__Generic__2": "Я за вас турбуюся, ви робите занадто багато помилок! Ну, зберіться! ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__Generic__NotWell3__010__M__Generic__3": "Капітане, давайте дотримуватися маршруту польоту. Не можна стільки помилятися!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AfterLandingCheck__010__M__Generic__1": "Можна приступати до перевірки за чек-листом після посадки. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AfterLandingCheck__010__M__Generic__2": "Готовність до виконання чек-листа після посадки. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AfterLandingCheck__010__M__Generic__3": "Чек-лист після посадки виконаний, капітан. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AfterStartCheck__010__M__Generic__1": "Готовність до перевірки за чек-листом після запуску, капітан.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AfterStartCheck__010__M__Generic__2": "Готовність до перевірки за чек-листом після запуску, капітан.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AfterStartCheck__010__M__Generic__3": "Готові виконувати чек-лист після запуску.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AfterTakeOffCheck__010__M__Generic__1": "Все готове для перевірки за чек-листом після зльоту. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AfterTakeOffCheck__010__M__Generic__2": "Готовність до виконання чек-листа після зльоту. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AfterTakeOffCheck__010__M__Generic__3": "Можна розпочати виконання чек-листа після посадки. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__ApproachCheck__010__M__Generic__1": "Можна приступати до перевірки за чек-листом заходу на посадку. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__ApproachCheck__010__M__Generic__2": "Готовність до перевірки за чек-листом заходу на посадку. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__ApproachCheck__010__M__Generic__3": "Чек-лист перед заходом на посадку виконано. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__ApproachCrotchAnnounce__010__M__Generic__1": "Я все обійду, виконаю перевірку безпеки і приберу сміття, що залишилося. Дякую. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__ApproachCrotchAnnounce__010__M__Generic__2": "Перед посадкою бортові провідники проведуть перевірку безпеки.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__ApproachCrotch__010__M__Generic__1": "Перевірка безпеки. Приготуйтеся до посадки.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__ApproachCrotch__010__M__Generic__2": "Бортпровідники, остання перевірка перед посадкою. Дякую за увагу. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcFreezingRain__010__M__Generic__1": "УВС повідомило про крижаний дощ, що насувається. Я відстежуватиму умови зледеніння. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcFreezingRain__010__M__Generic__2": "Капітан, УВС повідомило про крижаний дощ, що насувається. Приготуйтеся до можливої освіти криги. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcFreezingRain__010__M__Generic__3": "Капітан, УВС попередило про можливий крижаний дощ. Потрібно підготуватися до протиобмерзання...",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcGustNo__010__M__Generic__1": "УВС підтверджує: жодних поривів вітру. Політ обіцяє бути спокійним. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcGustNo__010__M__Generic__2": "УВС повідомило, що сильного вітру не буде. У небі сьогодні спокійно. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcGustNo__010__M__Generic__3": "УВС підтверджує слабкий вітер. Небо дає нам перепочинок. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcHail__010__M__Generic__1": "УВС попередило про град, що насувається. Можливо, нам варто облетіти цей район.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcHail__010__M__Generic__2": "УВС повідомляє, що попереду на нас чекає град. Рішення за вами, капітане. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcHail__010__M__Generic__3": "УВС повідомило про зливу з градом. Рішення за вами, капітане. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcHeavyRain__010__M__Generic__1": "УВС повідомляє про сильний дощ попереду. Вам потрібно вирішити, що робити. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcHeavyRain__010__M__Generic__2": "УВС попереджає про сильний дощ. Дайте знати, що робитимемо. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcHeavyRain__010__M__Generic__3": "УВС попереджає про сильний дощ, що насувається. Рішення, що робити далі за вами. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcLightRain__010__M__Generic__1": "Щойно отримано повідомлення від УВС: попереду слабкий дощ. Як зробите, капітане?",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcLightRain__010__M__Generic__2": "Допис від УВС: попереду можливий легкий дощ. Рішення за вами, капітане.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcLightRain__010__M__Generic__3": "УВС попередило про слабкий дощ, капітане. Проблем не повинно бути.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcRain__010__M__Generic__1": "УВС повідомляє про дощ, що насувається. Думаю, ми впораємося. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcRain__010__M__Generic__2": "УВС повідомляє, що попереду дощ. Здається він слабкий, але рішення за вами. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcRain__010__M__Generic__3": "Згідно з останнім повідомленням УВС, на нас очікує дощ. Можливо, нам варто бути уважнішими. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcSnow__010__M__Generic__1": "УВС повідомляє про снігопад. Капітан, можливо, варто уважніше стежити за свідченнями. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcSnow__010__M__Generic__2": "УВС повідомляє, що попереду снігопад.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcSnow__010__M__Generic__3": "Капітан, УВС повідомляє, що насувається снігопад. Варто підготуватися до потрапляння до снігової пелени. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcThunderstormNo__010__M__Generic__1": "УВС повідомляє, що грозової активності немає. Все чудово!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcThunderstormNo__010__M__Generic__2": "Дозвіл від УВС отримано. Штормової активності немає. Висуваємось!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcThunderstormNo__010__M__Generic__3": "УВС повідомляє, що попереду ясно небо. Жодної бурі — можна вилітати!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcThunderstormSevere__010__M__Generic__1": "Бортпровідники, термінове повідомлення від УВС. Попереду сильна гроза. Нас може сильно потрясти, тож будьте готові.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcThunderstormSevere__010__M__Generic__2": "Бортпровідники, УВС повідомило про сильну грозу неподалік. Приготуйтеся до турбулентності. Дякую за увагу.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcThunderstormSevere__010__M__Generic__3": "Бортпровідники УВС повідомляє, що наближається сильна гроза. Приготуйтеся до ґрунтовної трясіння! ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcThunderstormYes__010__M__Generic__1": "Бортпровідники, УВС повідомило про грозу, що наближається. Приготуйтеся та чекайте вказівок. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcThunderstormYes__010__M__Generic__2": "Бортпровідники, УВС повідомило про сильну грозу неподалік. Приготуйтеся до турбулентності. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcThunderstormYes__010__M__Generic__3": "Бортпровідники, УВС повідомило про грозу, що наближається. Приготуйтеся та чекайте вказівок. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcWindNo__010__M__Generic__1": "Згідно з останніми отриманими даними, на нас чекає штиль. Небо безтурботне. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcWindNo__010__M__Generic__2": "УВС повідомляє про слабкий вітер. Можна буде розслабитись.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcWindNo__010__M__Generic__3": "До уваги бортпровідників. УВС повідомило про слабкий вітер. Політ має пройти спокійно. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcWindYes__010__M__Generic__1": "Бортпровідники, УВС передає повідомлення про вітрову обстановку. Будьте обережні.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcWindYes__010__M__Generic__2": "Бортпровідники, УВС підтвердило прогноз про вітр, що насувається. Приготуйтеся: очікується, що вона буде сильною. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__AtcWindYes__010__M__Generic__3": "Бортпровідники, УВС повідомляє про сильний вітер, можливо на нас чекає турбулентність. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BadWeatherConfirmed__010__M__Generic__1": "АТІС підтверджує, що краще не стало. На шляху до аеропорту на нас чекає погана погода. Висота нижньої межі хмарності: {W:Cloud_Ceiling:Player}. Видимість: {W:Visibility:Player}. Захід на посадку: {M: Landing_Type}. Абсолютна висота прийняття рішень: {M: Landing_Minimum}. Сподіваюся, до нашого прибуття ситуація покращає...",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BadWeatherConfirmed__010__M__Generic__2": "АТІС повідомляє, що погодні умови, як і раніше, погані. Висота нижньої межі хмарності: {W:Cloud_Ceiling:Player}. Видимість: {W:Visibility:Player}. Захід на посадку: {M: Landing_Type}. Абсолютна висота прийняття рішень: {M: Landing_Minimum}. Сподіваюся, ближче до посадки ситуація покращає.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BadWeatherConfirmed__010__M__Generic__3": "Атіс підтверджує дуже погану погоду вночі. Висота нижньої межі хмарності: {W:Cloud_Ceiling:Player}. Видимість: {W:Visibility:Player} Захід на посадку: {M:Landing_Minimum}. Абсолютна висота прийняття рішень: {M: Landing_Minimum}. Сподіваюся, ближче до посадки ситуація покращає.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BadWeatherTease__010__M__Generic__2": "АТІС повідомляє про погану погоду та низьку видимість після прибуття.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BadWeatherTease__010__M__Generic__6": "Щойно надійшло повідомлення від Атіс. Попереду дощ, вітер та погана видимість. Все й одразу.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BadWeatherTease__010__M__Generic__7": "АТІС попереджає, що погодні умови погіршуються.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BadWeatherTease__020__M__Generic__1": "Посадка може виявитися непростою. Але, можливо, на той момент все налагодиться. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BadWeatherTease__020__M__Generic__2": "На той час, як ми дістанемося, прогноз може покращитись. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BadWeatherTease__020__M__Generic__3": "Сподіватимемося, що до нашого прибуття ситуація покращиться. Тримаємо кулачки. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BadWeatherTease__020__M__Generic__4": "Сподіваюся, на той час все налагодиться.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BadWeatherTease__020__M__Generic__5": "Напевно, все зміниться. І, швидше за все, набагато більше, ніж ми припускаємо. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BeforeStartCheck__010__M__Generic__1": "Готовність до перевірки за чек-листом перед запуском. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BeforeStartCheck__010__M__Generic__2": "Ви можете перевірити чек-лист перед запуском. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BeforeStartCheck__010__M__Generic__3": "Чек-лист перед запуском виконано. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BeforeTakeOffCheck__010__M__Generic__1": "Готовність до перевірки за чек-листом перед злетом, капітан. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BeforeTakeOffCheck__010__M__Generic__2": "Готовність до перевірки за чек-листом перед зльотом. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__BeforeTakeOffCheck__010__M__Generic__3": "Готовність до перевірки за чек-листом перед злетом. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__CarefulAnnouncement__010__M__Generic__1": "Будьте обережні під час висаджування. Телетрап слизький від криги. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__DescentBadWeatherLandingDecisionAlternate__020__M__Generic__1": "{M:Reroute_Airport_Name}.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__DescentBadWeatherLandingQuestion__010__M__Generic__1": "Чи підтверджуєте посадку?",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__DescentBadWeatherLandingQuestion__010__M__Generic__2": "Як зробите? ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__DescentBadWeatherLightsnook__010__M__Generic__1": "Видимість дуже низька. Нижче нікуди... ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__DescentBadWeatherLightsnook__020__M__Generic__1": "Залишилось палива: {S:Fuel_Total_Quantity:Volume}.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__DescentBadWeatherLightsok__010__M__Generic__1": "Схоже, все чудово.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__DescentBadWeather__010__M__Generic__1": "Зниження. Наближаємося до мінімальної висоти {M:Landing_Minimum}.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__DescentBadWeather__030__M__Generic__1": "Досягнуто мінімум: {M:Landing_Minimum}.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__DescentBadWeather__040__M__Generic__1": "Висвітлення ЗПС прямо за курсом. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EndAverage__010__M__Generic__1": "Усі ми сьогодні чудово попрацювали! Хоч нам довелося непросто, бути з вами в одній команді — суцільне задоволення! ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EndAverage__010__M__Generic__2": "Думаю, ми добре постаралися. Люблю цей маршрут: щоразу відбувається щось нове. І сьогодні політ видався непростим!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EndAverage__010__M__Generic__3": "Політ сьогодні видався важким. Давайте перевіримо статистику та дізнаємося про свої слабкі місця. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EndFinalShort__010__M__Generic__2": "Що ж, настав час обідати! А потім проведемо інструктаж із підготовки до наступного польоту. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EndNoOk__010__M__Generic__1": "Політ був непростий. Сподіваюся, пасажир не дуже засмутився. Вже не терпиться вивчити дані про політ і подивитися, що можна поліпшити. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EndNoOk__010__M__Generic__2": "Що так, політ сьогодні видався непростим. Може статистика підкаже, над якими моментами нам треба попрацювати. А поки що ми заслужили перепочинок! ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EndNoOk__010__M__Generic__3": "Сьогодні був непростий політ. Сподіваюся, наш гість не сильно скаржиться!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EndOk__010__M__Generic__1": "Здорово, що ми тут! Ви багато чого мене навчили. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EndOk__010__M__Generic__2": "Мені подобається це місце. Швидше б оглянути його як слід!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EndOk__010__M__Generic__3": "Чудовий політ, капітане! Дякую вам за те, що ділитеся досвідом! ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EndOk__020__M__Generic__1": "Спершу вип'ємо каву, а потім проведемо інструктаж з підготовки до наступного польоту.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EndOk__020__M__Generic__2": "Давайте спочатку пообідаємо, тоді ми матимемо час відпочити і поділитися кумедними історіями! ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EngineOffBoarding__010__M__Generic__1": "Перед посадкою пасажирів двигуни необхідно вимкнути. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__EngineOffBoarding__010__M__Generic__2": "Капітан, посадку пасажирів можна розпочати лише після вимкнення двигунів.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureEndMission__010__M__Generic__1": "Схоже, завдання не виконане. Мені шкода, капітане. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureEndMission__010__M__Generic__10": "Капітане, вибачте, але такий рейс — навряд чи привід для гордості. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureEndMission__010__M__Generic__2": "Схоже, що ми не можемо виконати завдання. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureEndMission__010__M__Generic__3": "Політ пішов за планом. Дуже шкода, капітане. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureEndMission__010__M__Generic__4": "Завдання пішло за планом. Але завжди можна спробувати знову. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureEndMission__010__M__Generic__5": "Капітан, завдання провалено. Може, вдруге пощастить. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureEndMission__010__M__Generic__6": "Очевидно, все пішло за планом. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureEndMission__010__M__Generic__7": "Завдання провалено. Наступного разу точно вийде. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureEndMission__010__M__Generic__8": "Завдання провалено. Мені шкода, капітане. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureEndMission__010__M__Generic__9": "Завдання провалено, капітане. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningBellyLanding__010__M__Generic__1": "Завдання виконане попри суворі умови. Вітаю!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningBellyLanding__010__M__Generic__2": "Така небезпечна посадка! Але, на щастя, усі вціліли. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningBellyLanding__010__M__Generic__3": "Незважаючи на грубу посадку, політ пройшов добре. Чудова робота!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningBoundaries__010__M__Generic__1": "Капітане, ви надто сильно відхилилися від маршруту в польотному плані. Скоригуйте курс. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningBoundaries__010__M__Generic__2": "Ви відхиляєтесь від польотного плану. Негайно скоригуйте курс.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningBoundaries__010__M__Generic__3": "Капітане, ви збилися з курсу. Необхідно дотримуватись маршруту польоту. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningDestructiveCrash__010__M__Generic__1": "Ваші дії можуть пошкодити літальний апарат!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningDestructiveCrash__010__M__Generic__2": "Якщо ви продовжите так літати літак довго не протримається.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningDestructiveCrash__010__M__Generic__3": "Якщо ви продовжите так літати літак довго не протримається. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningFuel__010__M__Generic__1": "Паливо закінчується. Можливо, ви не зможете завершити завдання. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningFuel__010__M__Generic__2": "Паливо закінчується. Його може вистачити для завершення місії. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningFuel__010__M__Generic__3": "Паливо закінчується. Є шанс, що ви не зможете завершити завдання. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningHarmingHumans__010__M__Generic__1": "Увага! Літальний апарат прямо за курсом! Негайно вживіть заходів!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningHarmingHumans__010__M__Generic__2": "Обережно! Можливе зіткнення!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningHarmingHumans__010__M__Generic__3": "Ризик зіткнення! Негайно здійсніть маневр!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningHarmingPassengers__010__M__Generic__1": "Будете й далі так летіти — нашкодьте пасажирам! ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningHarmingPassengers__010__M__Generic__2": "Капітане, якщо так літатимете, покалічіть пасажирів...",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningHarmingPassengers__010__M__Generic__3": "Обережніше, бо нашкодите пасажирам!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningHypoxia__010__M__Generic__1": "Літальний апарат негерметичний. Летіти так високо небезпечно. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningHypoxia__010__M__Generic__2": "Цей літальний апарат негерметичний, тому летіти на такій висоті небезпечно. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningHypoxia__010__M__Generic__3": "Цей літальний апарат негерметичний. Підйом на більшу висоту призведе до серйозних наслідків. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningLeavePlane__010__M__Generic__1": "Що ви робите? Не залишайте літак. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningLeavePlane__010__M__Generic__2": "Ви потрібні нам на борту. Будь ласка, поверніться. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningLeavePlane__010__M__Generic__3": "Вам час вилітати. Поверніться до літака. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningNightfall__010__M__Generic__1": "Будьте обережні та не літайте вночі. А то мало...",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningNightfall__010__M__Generic__2": "Жодних польотів у нічний час. Чи не забули? ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningNightfall__010__M__Generic__3": "Наближається ніч, а ви не атестовані для польотів.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningUnexpectedLanding__010__M__Generic__1": "Уважніше, капітане. Приземлення тут заборонено. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningUnexpectedLanding__010__M__Generic__2": "Тут не можна сідати. Пам'ятайте про завдання. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FailureWarningUnexpectedLanding__010__M__Generic__3": "Капітане, ми не повинні були тут приземлятися.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight1__010__M__Generic__1": "Капітане, люди починають скаржитися на турбулентність. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FeedbackBumpyFlight1__010__M__Generic__2": "Хочу повідомити, деякі пасажири скаржаться на турбулентність. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FlapsOverspeedWarning__010__M__Generic__1": "Обережно перевищення швидкості закрилків. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FlapsOverspeedWarning__010__M__Generic__2": "Капітан перевищення швидкості з випущеними закрилками. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FlapsOverspeedWarning__010__M__Generic__3": "Занадто велика швидкість при випущених закрилках. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FlightCheck__010__M__Generic__1": "Перевірку за чек-листом виконуємо разом, капітане? Я можу й сам — вам вирішувати. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FlightCheck__010__M__Generic__2": "Я готовий виконати чек-лист.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FlightCheck__010__M__Generic__3": "Ми можемо виконати чек-лист разом. Або я можу це зробити сам.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FuelEmptyWarningReminder__010__M__Generic__1": "Капітан, паливний бак порожній. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FuelEmptyWarningReminder__010__M__Generic__2": "Капітан, паливо на нулі. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FuelEmptyWarningReminder__010__M__Generic__3": "Капітан, паливо на нулі. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FuelFiftyPercent__010__M__Generic__1": "У баку менше ніж 50% палива. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FuelFiftyPercent__010__M__Generic__2": "Капітане, від нашого запасу палива залишилося менше половини.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FuelFiftyPercent__010__M__Generic__3": "Капітан індикатор палива показує значення нижче 50%.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FuelTwentyFivePercent__010__M__Generic__1": "Капітан залишилося менше 25% палива.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FuelTwentyFivePercent__010__M__Generic__2": "Капітан залишилося менше 25% палива.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__FuelTwentyFivePercent__010__M__Generic__3": "Капітан індикатор палива показує, що залишилося менше 25%.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__GenericLightsOnReminder__010__M__Generic__1": "Капітане, необхідно включити всі вогні! ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__GenericLightsOnReminder__010__M__Generic__2": "Для цього нам потрібно увімкнути всі вогні. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__GenericLightsOnReminder__010__M__Generic__3": "Просто нагадую, що зараз необхідно увімкнути всі вогні. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__IntroPrivateTogetherAgain__010__M__Generic__1": "Здрастуйте, капітане! Скільки років, скільки зим!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__IntroPrivateTogetherAgain__010__M__Generic__2": "{T: Hello:Uppercase}, капітане! Скільки років, скільки зим. Так приємно знову летіти у вашій компанії!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__IntroPrivate__010__M__Generic__4": "Приємно летіти з вами, капітане. ",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__IntroPrivate__010__M__Generic__5": "Радий знову летіти з вами!",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__LandingCheck__010__M__Generic__1": "Готові до виконання чек-листа під час посадки.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__LandingCheck__010__M__Generic__2": "Готовність до перевірки посадкового чек-листа, капітан.",
      "PrivateCharter.VO__COPILOT__PrivateCharter__PlaneCabinCrew__LandingCheck__010__M__Generic__3": "Чек-лист після посадки виконаний, капітан.",
