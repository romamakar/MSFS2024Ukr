        "Languages": {
          "de-DE": {
            "Text": "Bringen Sie uns jetzt wieder in eine gerade Position.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Now, let's level back out.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Ahora, vamos a volver al vuelo uniforme.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Ahora, nivelémonos de nuevo.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Siirrytään takaisin vaakalentoasentoon.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Maintenant, revenons à la position initiale.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Ora rimetti l'aeromobile a livello.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "水平に戻りましょう。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "자, 다시 수평을 유지합시다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "La oss rette opp igjen.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Laten we nu weer overgaan in horizontale vlucht.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Teraz wyrównajmy.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Agora, vamos nivelar de volta.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Agora, volte a nivela para fora.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "А теперь выровняйте самолёт.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Nu ska vi plana ut igen.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Tamam, şimdi tekrar düz uçuş moduna geçin.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "现在让我们重新拉平。",
            "LocalizationStatus": "TranslationOk"
          }
        }
