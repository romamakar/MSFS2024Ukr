      "9d3554f9-b2d5-4534-8b21-8fdeb9c85aae": {
        "Name": "AttitudesPitch.Step_Maintain_Pitch_Up",
        "Comment": "Placeholder refers to an input button from the players chosen controller",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Mit {STR_AXIS_ELEVATOR_SET} die untere Linie 20 Sekunden auf dem Horizont halten",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Maintain the lower line onto the horizon for 20 seconds using {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Mantén la línea inferior en el horizonte durante 20 segundos con {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Mantén la línea inferior en el horizonte durante 20 segundos con {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Pidä alaviiva horisontin kohdalla 20 sekunnin ajan {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Maintenir la ligne du haut sur l'horizon pendant 20 secondes en utilisant {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Mantieni la linea inferiore sull'orizzonte per 20 secondi con {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "{STR_AXIS_ELEVATOR_SET} で水平線上に下側のラインを 20 秒間維持する",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "하단 선을 20초 동안 수평선에 유지 ({STR_AXIS_ELEVATOR_SET} 사용)",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Hold den nederste linjen på horisonten i 20 sekunder ved å bruke {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Houd de onderste lijn gedurende 20 seconden op de horizon geplaatst met behulp van {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Utrzymaj dolną linię na horyzoncie przez 20 sekund za pomocą {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Mantenha a linha inferior no horizonte por 20 segundos usando {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Mantenha a linha inferior no horizonte por 20 segundos ao utilizar {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Удерживайте нижнюю линию на уровне горизонта в течение 20 секунд с помощью {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Håll den nedre linjen på horisonten i 20 sekunder med {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "{STR_AXIS_ELEVATOR_SET} ile alt çizgiyi 20 saniye boyunca ufukta tutun",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "按下{STR_AXIS_ELEVATOR_SET}将下方的线保持在地平线上20秒钟",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "15bd11e5-6dda-4dbf-bdf1-45219b195646": {
        "Name": "AttitudesPitch.Briefing.FullBrief",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2025-03-07 15:41:35",
        "LocalizationStatus": "PlaceHolder",
        "Languages": {
          "de-DE": {
            "Text": "In diesem Tutorial lernen Sie die Grundlagen des Fluglagenmanagements kennen. </br></br> Die Fluglage bezieht sich auf die Ausrichtung des Flugzeugs in Bezug auf den Horizont, sei es durch Neigung* oder Rolle*. </br></br> In diesem Tutorial lernen Sie, wie Sie 3 Neigungslagen steuern können: </br></br><li>Steigflug <li>Reiseflug <li>Sinkflug </br></br> Sie lernen auch die Beziehung zwischen Neigung und Geschwindigkeit kennen. Wenn Sie nach oben neigen, verringert sich die Geschwindigkeit. Neigen Sie nach unten, erhöht sie sich. </br></br> In der Abbildung rechts stellen die gestrichelten Linien die Position des Horizonts beim Auf- oder Abstieg dar. </br></br> Verwechseln Sie nicht <b>Fluglage</b> mit <b>Höhe</b> (auch wenn es eine Korrelation zwischen den beiden gibt, da die Höhe je nach Fluglage gewonnen oder verloren wird). </br></br>*<b>Neigung</b> = Eine der drei Hauptbewegungsachsen, die durch das Höhenruder betätigt wird. Dies ermöglicht das Neigen des Flugzeugs nach oben oder unten (von der Nase zum Heck), was in der Regel zu einem Höhengewinn oder -verlust führt. </br>*<b>Rolle</b> = Eine weitere Hauptbewegungsachse, die von den Querrudern betätigt wird. Dies ermöglicht es dem Flugzeug, von einer Seite zur anderen (von Flügelspitze zu Flügelspitze) um eine zentrale Achse zu schaukeln, was in Kombination mit dem Höhenruder zu einer Drehung führt.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "In this tutorial you will learn the basics of attitude management. </br></br> Attitude refers to the aircraft's orientation in relation to the horizon be it through pitch* or roll*. </br></br> You will learn to manage 3 pitch attitudes in this tutorial: </br></br><li>Climb <li>Cruise <li>Descent </br></br> You will also learn about the relationship between pitch and speed. Pitching up will cause the speed to decrease while pitching down will cause it to increase. </br></br> In the image to the right, the dashed lines represent the horizon's position when ascending or descending. </br></br> Do not confuse <b>attitude</b> with <b>altitude</b> (even if there is a correlation between the two since altitude is gained or lost depending on the plane's attitude). </br></br>*<b>Pitch</b> = One of the three principal axes of movement, actuated by the elevator. This allows an aircraft to tilt up or down (from nose to tail), usually resulting in a gain or loss of altitude. </br> *<b>Roll</b> = Another principal axis of movement, actuated by the ailerons. This allows the aircraft to rock from side to side (from wing-tip to wing-tip) around a central axis, resulting in a turn when combined with some elevator input.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "En este tutorial aprenderás los conceptos básicos para gestionar la actitud. </br></br>La actitud hace referencia a la posición del morro del avión en relación con el horizonte, ya sea mediante cabeceo* o balanceo*. </br></br>Aprenderás a gestionar 3 actitudes de cabeceo en este tutorial: </br></br><li>Ascenso. <li>Crucero. <li>Descenso. </br></br>También aprenderás la relación entre el cabeceo y la velocidad. Aumentar el cabeceo hará que disminuya la velocidad, mientras que disminuir el cabeceo hará que aumente. </br></br>En la imagen de la derecha, las líneas discontinuas representan la posición del horizonte al ascender o descender.  </br></br>No se debe confundir la <b>actitud</b> con la <b>altitud</b> (incluso si hay correlación entre ambas, ya que la altitud se gana o se pierde según la actitud del avión). </br></br>*<b>Cabeceo</b> = Uno de los tres ejes principales de movimiento que acciona el timón de profundidad. Esto permite que una aeronave se incline hacia arriba o hacia abajo (desde el morro hasta la cola), lo que suele dar lugar a una ganancia o pérdida de altitud. </br>*<b>Balanceo</b> = Otro eje principal de movimiento, accionado por los alerones. Esto permite que la aeronave se mueva de lado a lado (desde el extremo de un ala al extremo de la otra) alrededor de un eje central, lo que se traduce en un giro cuando se combina con un poco de profundidad.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "En este tutorial aprenderás los conceptos básicos para gestionar la actitud. </br></br>La actitud hace referencia a la posición de la nariz del avión en relación con el horizonte, ya sea mediante cabeceo* o balanceo*. </br></br>Aprenderás a gestionar 3 actitudes de cabeceo en este tutorial: </br></br><li>Ascenso. <li>Crucero. <li>Descenso. </br></br>También aprenderás la relación entre el cabeceo y la velocidad. Aumentar el cabeceo hará que disminuya la velocidad, mientras que disminuir el cabeceo hará que aumente. </br></br>En la imagen de la derecha, las líneas discontinuas representan la posición del horizonte al ascender o descender.  </br></br>No se debe confundir la <b>actitud</b> con la <b>altitud</b> (incluso si hay correlación entre ambas, ya que la altitud se gana o se pierde según la actitud del avión). </br></br>*<b>Cabeceo</b> = Uno de los tres ejes principales de movimiento que acciona el timón de profundidad. Esto permite que una aeronave se incline hacia arriba o hacia abajo (desde la nariz hasta la cola), lo que suele dar lugar a una ganancia o pérdida de altitud. </br>*<b>Balanceo</b> = Otro eje principal de movimiento, accionado por los alerones. Esto permite que la aeronave se mueva de lado a lado (desde el extremo de un ala al extremo de la otra) alrededor de un eje central, lo que se traduce en un giro cuando se combina con un poco de profundidad.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Tällä oppitunnilla opetellaan lentoasennon hallinnan perusteet. </br></br> Lentoasennolla tarkoitetaan ilma-aluksen kallistusta poikittais-* tai pituusakselin* ympäri suhteessa horisonttiin. </br></br> Tällä oppitunnilla opit hallitsemaan kolmea eri pituuskallistusta: </br></br><li>Nousu<li>Matkalento<li>Laskeutuminen </br></br>Saat myös tietoa pituuskallistuksen eli nyökkäämisen ja nopeuden välisestä suhteesta. Pituuskallistus ylös pienentää nopeutta ja pituuskallistus alas suurentaa nopeutta. </br></br> Oikealla olevassa kuvassa katkoviivat kuvaavat horisontin paikkaa nousussa ja laskussa. </br></br><b>Lentoasentoa</b> ei pidä sekoittaa <b>korkeuteen</b> (vaikka ne liittyvätkin toisiinsa, sillä korkeus kasvaa tai laskee lentoasennon mukaan). </br></br>* <b>Pituuskallistus</b> = Yksi koneen kolmesta akselin ympäri tapahtuvasta pääliikesuunnasta, jota hallitaan korkeusperäsimellä. Kone voi kallistua pituussuunnassa (nokasta pyrstöön) ylös tai alas, jolloin tuloksena on tyypillisesti korkeuden lisääntyminen tai väheneminen. </br>* <b>Kallistus pituusakselin ympäri</b> = Toinen pääliikesuunta, jota hallitaan siivekkeillä. Kone voi kallistua sivulta toiselle (sivusuunnassa siivenkärjestä toiseen) pituusakselin ympäri, ja kun tähän yhdistetään korkeusperäsimen kääntäminen, kone kääntyy.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Dans ce tutoriel, vous apprendrez les bases de la gestion de l'assiette. </br></br> L'assiette désigne l'orientation de l'appareil par rapport à l'horizon, en terme de tangage* ou de roulis*. </br></br> Dans ce tutoriel, vous apprendrez à gérer 3 assiettes longitudinales :</br></br><li>Montée<li>Croisière<li>Descente </br></br> Vous en apprendrez également davantage sur la relation entre tangage et vitesse. Tanguer vers le haut (cabrer) fera perdre de la vitesse à l'appareil tandis que tanguer vers le bas (piquer) lui en fera prendre. </br></br> Sur l'image à droite, les lignes en pointillés représentent la position de l'horizon pendant la montée ou la descente. </br></br> Ne confondez pas <b>assiette</b> et <b>altitude</b> (cela dit, il existe bien un lien entre les deux : l'appareil prend ou perd de l'altitude en fonction de son assiette). </br></br> <b>*Tangage</b> = Un des trois axes de mouvement principaux, géré par la gouverne de profondeur. Permet d'incliner l'appareil vers l'avant ou vers l'arrière (du nez à la queue), ce qui lui fait généralement prendre ou perdre de l'altitude.</br> <b>*Roulis</b> = Un des trois axes de mouvement principaux, géré par les ailerons. Permet de faire pencher l'appareil d'un côté ou de l'autre (d'une extrémité d'aile à l'autre) autour d'un axe central, ce qui, conjugué à la gouverne de profondeur, permet d'effectuer des virages.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "In questo tutorial apprenderai le basi della gestione dell'assetto. </br></br> Con assetto si intende l'orientamento dell'aeromobile rispetto alla linea dell'orizzonte, sia in termini di beccheggio* sia di rollio*. </br></br> Imparerai a gestire tre assetti di beccheggio: </br></br><li>salita; <li>crociera; <li>discesa. </br></br> Approfondiremo inoltre il rapporto tra beccheggio e velocità. Il beccheggio verso l'alto tende a ridurre la velocità, mentre il beccheggio verso il basso la aumenta. </br></br> Nell'immagine a destra, le linee tratteggiate rappresentano la posizione dell'orizzonte durante la salita o la discesa. </br></br> Non bisogna confondere l'<b>assetto</b> con l'<b>altitudine</b>, benché i due valori siano correlati, dato che l'altitudine varia in base all'assetto. </br></br>*<b>Beccheggio</b> = uno dei tre assi di movimento principali, controllato tramite l'equilibratore. Consente all'aereo di inclinarsi verso l'alto o verso il basso (dal muso alla coda), comportando solitamente un guadagno o una perdita di quota. </br> *<b>Rollio</b> = un altro asse di movimento principale, controllato tramite gli alettoni. Consente all'aereo di oscillare lateralmente (da un'estremità alare all'altra) attorno a un asse centrale, il che si traduce in una virata se combinato a un input di equilibratore.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "このチュートリアルでは、姿勢管理の基本を学習します。</br></br>姿勢とは、ピッチまたはロールによる、水平線に対する航空機の向きを指します。</br></br>このチュートリアルでは、3 つのピッチ姿勢を管理する方法を学びます:</br></br><li>上昇姿勢<li>水平飛行姿勢<li>降下姿勢</br></br>また、ピッチと速度の関係についても学習します。機首を上げると速度が減少し、機首を下げると速度が増加します。</br></br>右の画像では、破線は上昇時または降下時の地平線の位置を表しています。</br></br><b>姿勢 (アティチュード)</b> と<b>高度 (アルティチュード)</b> を混同しないでください (航空機の姿勢によって高度が変化するため、両者には関連性がありますが)。</br></br><b>ピッチ</b> = 3 つの主要な運動軸の 1 つで、エレベーターによって制御されます。航空機が上方向または下方向に傾く (機首から尾部の傾き) ことを可能にし、通常は高度の増減につながります。</br><b>ロール</b> = もう 1 つの主要な運動軸で、エルロンによって制御されます。航空機が中心軸を中心に左右に傾く (翼端から翼端の傾き) ことを可能にし、エレベーター操作と組み合わせて旋回します。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "이 튜토리얼에서는 자세 관리의 기초를 배우게 됩니다. </br></br> 자세는 수평선을 기준으로 한 항공기의 기수 방향을 말하며 피치* 또는 롤*을 통해 구사합니다. </br></br> 이 튜토리얼에서는 다음의 3가지 피치 자세를 취하는 방법을 배웁니다. </br></br><li>상승 <li>순항 <li>하강 </br></br> 또한 피치와 속도의 관계에 대해서도 배우게 됩니다. 피치를 올리면 속도가 감소하고 피치를 낮추면 속도가 증가합니다. </br></br> 오른쪽 이미지에서 점선은 상승 또는 하강할 때 수평선의 위치를 나타냅니다.</br></br> <b>자세</b>와 <b>고도</b>를 혼동하지 마세요. 비행기의 자세에 따라 고도가 증가하거나 감소하기 때문에 둘 사이에 상관관계가 있긴 하지만요.</br></br>*<b>피치</b> = 승강타에 의해 작동되는 세 가지 주요 이동 축 중 하나. 항공기가 기수에서 꼬리까지 위 또는 아래로 기울어질 수 있도록 하여 일반적으로 고도를 높이거나 낮춥니다. </br> *<b>롤</b> = 에일러론에 의해 작동되는 또 다른 주요 이동 축. 항공기가 중심축을 중심으로 좌우로(날개 끝에서 날개 끝까지) 흔들릴 수 있으므로 승강타 실행과 결합할 때 회전이 발생합니다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "I denne opplæringen lærer du det grunnleggende om å holde nesestillingen.</br></br>Nesestillingen indikerer flyets neseposisjon i forhold til horisonten, via høydeaksen* eller lengdeaksen*.</br></br>Du lærer å håndtere tre nesestillinger i denne opplæringen:</br></br><li>Stigning<li>Marsjflyvning<li> Nedstigning</br></br>Du lærer også om forholdet mellom nesestilling og fart. Når du setter nesen opp, fører dette til at farten reduseres, og når du setter den ned, øker farten.</br></br>På bildet til høyre representerer de stiplede linjene horisontens posisjon ved stigning eller nedstigning.</br></br>Ikke forveksle <b>nesestilling</b> med <b>høyde</b> (selv om det er en sammenheng mellom de to, siden høyde oppnås eller går tapt avhengig av flyets nesestilling). </br></br>*<b>Høydeaksen</b> = En av de tre viktigste bevegelsesaksene, justeres av høyderoret. Lar et fly vippe opp eller ned (fra nese til hale), noe som vanligvis resulterer i økning eller tap av høyde.</br> *<b>Lengdeaksen</b> = En annen hovedbevegelsesakse, aktivert av balanserorene. Lar flyet krenge fra side til side (fra vingespiss til vingespiss) rundt en sentral akse, noe som resulterer i en sving når det kombineres med en justering av høyderoret.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "In deze tutorial leer je de basisprincipes van het beheren van de vliegtuigstand. </br></br>Vliegtuigstand verwijst naar de oriëntatie van het vliegtuig ten opzichte van de horizon, of het nu gaat om pitch* of rol*. </br></br> In deze tutorial leer je 3 pitch-standen te beheren: </br></br><li>Klimmen <li>Kruisen <li>Dalen </br></br> Je leert ook over de relatie tussen pitch en snelheid. Een pitch omhoog zal ervoor zorgen dat de snelheid afneemt, terwijl een pitch omlaag ervoor zal zorgen dat deze toeneemt. </br></br> In de afbeelding rechts geven de stippellijnen de positie van de horizon weer bij het stijgen of dalen. </br></br> Verwar <b>vliegtuigstand</b> niet met <b>hoogte</b> (zelfs als er een correlatie is tussen die twee, aangezien hoogte wordt gewonnen of verloren afhankelijk van de stand van het vliegtuig). </br></br>*<b>Pitch</b> = Een van de drie belangrijkste bewegingsassen, bediend door het hoogteroer. Hiermee kan een vliegtuig omhoog of omlaag kantelen (van neus naar staart), wat meestal resulteert in een toename of verlies van hoogte. </br> *<b>Rol</b> = Een andere hoofdbewegingsas, bediend door de rolroeren. Hiermee kan het vliegtuig van links naar rechts schommelen (van vleugeltip tot vleugeltip) rond een centrale as, wat resulteert in een bocht in combinatie met wat hoogteroer.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "W tym samouczku nauczysz się podstaw sterowania pochyleniem. </br></br> Kąt nachylenia maszyny to pozycja statku powietrznego w stosunku do horyzontu poprzez pochylenie* lub przechylenie*. </br></br> W tym samouczku nauczysz się sterować 3 zakresami pochylenia: </br></br><li>Wznoszenie<li>Przelot<li> Zniżanie </br></br>Poznasz również związek między pochyleniem a prędkością. Odchylenie w górę spowoduje zmniejszenie prędkości, podczas gdy pochylenie w dół spowoduje jej wzrost. </br></br>Na obrazie po prawej stronie przerywane linie oznaczają położenie horyzontu podczas wznoszenia lub opadania. </br></br>Nie należy mylić <b>pochylenia</b> z <b>wysokością</b> (nawet jeśli istnieje związek między nimi, ponieważ wysokość jest zwiększana lub zmniejszana w zależności od pochylenia samolotu). </br></br>*<b> Pochylenie</b> = Jedna z trzech głównych osi ruchu, regulowana przez ster wysokości. Umożliwia pochylanie samolotu w górę lub w dół (od dzioba do ogona), co zwykle powoduje zwiększenie lub utratę wysokości.</br> *<b> Przechylenie</b> = Inna główna oś ruchu, regulowana przez lotki. Sprawia, ze samolot kołysze się z boku na bok (od końcówki jednego skrzydła do drugiego) po osi środkowej, co z pewnym udziałem steru wysokości powoduje skręt.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Neste tutorial, você aprenderá os conceitos básicos sobre gerenciamento de atitude. </br></br> Atitude refere-se à orientação da aeronave em relação ao horizonte, seja por meio de arfagem* ou rolamento*. </br></br> Você aprenderá a gerenciar 3 atitudes de arfagem neste tutorial: </br></br><li>Subida <li>Cruzeiro <li>Descida </br></br> Você também aprenderá sobre a relação entre arfagem e velocidade. Elevar o nariz fará a velocidade diminuir, enquanto abaixá-lo fará a velocidade aumentar. </br></br> Na imagem à direita, as linhas tracejadas representam a posição do horizonte durante a ascensão ou descida. </br></br> Não confunda <b>atitude</b> com <b>altitude</b> (mesmo que haja uma correlação entre as duas, já que a altitude é ganha ou perdida dependendo da atitude da aeronave). </br></br>*<b>Arfagem</b> = Um dos três eixos principais de movimento, controlado pelo profundor. Isso permite que a aeronave incline-se para cima ou para baixo (do nariz à cauda), geralmente resultando em ganho ou perda de altitude. </br> *<b>Rolagem</b> = Outro eixo principal de movimento, controlado pelos ailerons. Isso permite que a aeronave balance de um lado para o outro (de ponta de asa a ponta de asa) ao redor de um eixo central, resultando em uma curva quando combinado com algum comando de profundor.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Neste tutorial, vai aprender o essencial sobre a gestão da atitude. </br></br> “Atitude” refere-se à orientação da aeronave relativamente ao horizonte, seja por inclinação* ou rolamento*. </br></br> Vai aprender a gerir 3 atitudes de inclinação neste tutorial: </br></br><li>Subida <li>Cruzeiro <li>Descida </br></br> Também vai aprender sobre a relação entre a inclinação e a velocidade. Inclinar a aeronave para cima reduz a velocidade e incliná-la para baixo aumenta a velocidade. </br></br> Na imagem à direita, as linhas tracejadas representam a posição do horizonte ao subir ou descer. </br></br> Não confunda <b>atitude</b> e <b>altitude</b> (embora haja uma correlação ambas, visto que a altitude é ganha ou perdida conforme a atitude do avião). </br></br>*<b>Inclinação</b> = um dos três principais eixos de movimento; é controlada pelo leme de profundidade. Isto permite que a aeronave se incline para cima ou para baixo (do nariz à cauda), o que normalmente resulta no ganho ou na perda de altitude. </br> *<b>Rolamento</b> = outro eixo principal de movimento; é controlado pelos ailerons. Isto permite que a aeronave oscile de um lado para o outro (de uma ponta de asa a outra ponta de asa) em torno de um eixo central, o que resulta numa curva quando é combinado com o controlo do leme de profundidade.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "В этом уроке вы узнаете об основах пространственного положения. </br></br> Пространственное положение — ориентация самолета относительно горизонта по тангажу* или по крену*. </br></br> Здесь вы научитесь управлять 3 видами тангажа в пространственном положении: </br></br><li>Подъем. <li>Крейсерская высота. <li>Снижение. </br></br> Еще вы узнаете о взаимосвязи между тангажом и скоростью. При увеличении угла наклона скорость уменьшается, а при уменьшении — увеличивается. </br></br> На изображении справа пунктирные линии обозначают положение горизонта при подъеме или снижении. </br></br> Не путайте <b>пространственное положение</b> с <b>абсолютной высотой</b> (даже если между ними есть корреляция, поскольку абсолютная высота набирается или теряется в зависимости от положения самолета). </br></br>*<b>Тангаж</b> — одна из трех основных осей движения, приводимая в действие элеваторами. Тангаж позволяет самолету отклоняться вверх или вниз (от носа к хвосту), что обычно приводит к набору или потере высоты. </br> *<b>Крен</b> — другая главная ось движения, приводимая в действие элеронами. Крен позволяет самолету раскачиваться из стороны в сторону (от одного кончика крыла до другого) вокруг центральной оси, что приводит к повороту в сочетании с использованием элеваторов.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "I den här handledningen kommer du att lära dig grunderna i attitydhantering.</br></br>Attityd avser flygplanets orientering i förhållande till horisonten, vare sig det är genom pitch* eller roll*.</br></br>Du kommer att lära dig att hantera 3 pitchattityder i den här handledningen:</br></br><li>Stigning<li>Marsch<li>Nedstigning</br></br>Du kommer också att lära dig om förhållandet mellan pitch och fart. Om du pitchar upp kommer farten att minska medan pitch ner kommer att få den att öka.</br></br>I bilden till höger representerar de streckade linjerna horisontens position när du åker uppåt eller nedåt.</br></br>Blanda inte ihop <b>attityd</b> med <b>höjd</b> (även om det finns ett samband mellan de två eftersom höjd vinns eller förloras beroende på planets position).</br></br>*<b>Pitch</b> = En av de tre huvudsakliga rörelseaxlarna, som aktiveras av höjdrodret. Gör det möjligt för ett flygplan att luta uppåt eller nedåt (från nos till stjärt), vilket vanligtvis resulterar i en ökning eller förlust av höjd.</br>*<b>Roll</b> = En annan huvudaxel för rörelse, som aktiveras av skevrodren. Gör det möjligt för flygplanet att gunga från sida till sida (från vingspets till vingspets) runt en central axel, vilket resulterar i en sväng i kombination med viss höjdroderinmatning.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Bu eğitimde durum yönetiminin temellerini öğreneceksiniz. </br></br> Durum, hava aracının ufka göre olan yunuslama* veya tono* hareketini gösterir. </br></br> Bu eğitimde 3 yunuslama durumunu gerçekleştirmeyi öğreneceksiniz:</br></br><li>Tırmanış <li>Seyir <li>Alçalma </br></br> Ayrıca yunuslama ve hız arasındaki ilişkiyi de kavrayacaksınız. Örneğin hava aracını yukarı kaldırmak hızı azaltırken aşağı indirmek hızı artırır. </br></br> Sağdaki görüntüde kesikli çizgiler, tırmanış veya iniş sırasında ufkun konumunu temsil eder. </br></br> Her ne kadar aralarında bir ilişki olsa da <b>durumu</b> <b>irtifa</b> ile karıştırmamalısınız çünkü irtifa, hava aracının durumuna bağlı olarak kazanılır veya kaybedilir.</br></br>*<b>Yunuslama</b> = Üç ana hareket ekseninden biridir ve irtifa dümeni aracılığıyla gerçekleştirilir. Bir hava aracının burundan kuyruğa doğru yukarı kalkmasını veya aşağı eğilmesini sağlar ve genellikle irtifa kazancı veya kaybıyla sonuçlanır. </br>  *<b>Tono</b> = Bir diğer ana hareket eksenidir ve kanatçıklar tarafından gerçekleştirilir. Hava aracının bir kanat ucundan diğer kanat ucuna merkezi bir eksen etrafında yanlara doğru sallanmasını sağlar ve genellikle irtifa dümeni hareketiyle birleştiğinde dönüşle sonuçlanır.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "在本教程中，你将学习姿态管理的基础知识。</br></br>姿态是指飞机相对于地平线的方向，无论是通过俯仰*还是横滚*。</br></br>你将在本教程中学习管理3种俯仰姿态：</br></br><li>爬升<li>巡航<li>下降</br></br>你还将学习俯仰与速度之间的关系。机头上仰会导致速度下降，而机头下俯则会导致速度上升。</br></br>在右侧的图像中，虚线表示爬升或下降时地平线的位置。</br></br>不要将<b>姿态</b>与<b>高度</b>混淆（尽管两者之间有一定的关联，因为高度是根据飞机的姿态而增加或减少的）。</br></br>*<b>俯仰</b>=三个主要运动轴之一，由升降舵控制。该动作能使飞机上下倾斜（从机头到机尾），通常会导致高度的增加或减少。</br>*<b>横滚</b>=另一个主要运动轴，由副翼控制。该动作能使飞机围绕中央轴线左右摆动（从翼尖到翼尖），在结合一定的升降舵输入时导致转弯。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "43c389e2-efb3-4770-8513-64bb7b5cb7f7": {
        "Name": "AttitudesPitch.Dlg_PitchDown2Reminder",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Nun drücken Sie das Steuerhorn sanft nach vorn. Wenn die Sinkfluglage mit dem Horizont übereinstimmt, behalten Sie diese Fluglage bei.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Push on the yoke gently, just until the descent attitude line matches the horizon. Then hold that attitude.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Empuja el volante suavemente, justo hasta que la línea de actitud de descenso coincida con el horizonte. Después mantén esa actitud.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Empuja el volante suavemente, justo hasta que la línea de actitud de descenso coincida con el horizonte. Después mantén esa actitud.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Työnnä varovasti ohjaussauvaa siihen asti, kunnes horisontti on vajoamisasentoviivan kohdalla. Sitten pidä tuo lentoasento.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Poussez légèrement le manche jusqu'à ce que la ligne d'assiette de descente s'aligne sur l'horizon. Pas plus. Ensuite, maintenez-la.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Spingi delicatamente la barra fino a quando la linea di assetto di discesa non corrisponde all'orizzonte. Mantieni poi quell'assetto.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "ヨークをゆっくり押し、降下姿勢線と地平線が重なったらその姿勢を維持します。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "조종간을 앞으로 부드럽게 밀어 '하강 자세' 선을 수평선과 일치시킨 다음, 자세를 그대로 유지하십시오.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Skyv lett på styrespaken til linjen for nedstigningsorienteringen samsvarer med horisonten, deretter holder du denne orienteringen.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Duw de stuurkolom rustig naar voren totdat de lijn voor de daalvluchthouding overeenkomt met de horizon. Houd vervolgens die vluchthouding aan.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Delikatnie odepchnij wolant, by linia pochylenia przy zniżaniu zrównała się z horyzontem. Utrzymuj to pochylenie.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Pique o manche suavemente, até que a linha da atitude de descida corresponda ao horizonte. Então mantenha essa atitude.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Empurre a manche suavemente, até que a linha de atitude de descida corresponda ao horizonte. Então mantenha esta atitude.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Не спеша дайте штурвал от себя, пока линия снижения не совпадёт с линией горизонта. Затем сохраняйте это пространственное положение.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Tryck försiktigt på styrspaken tills linjen för sjunkattityd matchar horisonten. Bibehåll sedan den attityden.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "İniş durumu çizgisi ufka uyana kadar lövyeyi yavaşça itin. Sonra bu durumu koruyun.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "轻轻推动控制杆，直至下降姿态线与地平线重合，然后保持该姿态。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "53a03f06-c28c-4483-9f71-c8412e45dcda": {
        "Name": "AttitudesPitch.Dlg_Intro4Reminder2",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-10-07 17:36:56",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Wenn die Steigfluglagenlinie mit dem Horizont übereinstimmt, behalten Sie diese Fluglage bei.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "When the climb attitude line matches the horizon, maintain that attitude.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Cuando la línea de actitud de ascenso coincida con el horizonte, mantén esa actitud.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Cuando la línea de actitud de ascenso coincida con el horizonte, mantén esa actitud.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Kun horisontti on nousuasentoviivan kohdalla, pidä lentoasento.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Lorsque le trait d'assiette de montée s'aligne sur l'horizon, maintenez-la.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Quando la linea di assetto di salita corrisponde all'orizzonte, mantieni quell'assetto.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "上昇姿勢線と地平線が重なったら、その姿勢を維持します。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "상승 자세 선이 지평선과 일치하면 그대로 유지하세요.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Når linjen for stigningsorientering samsvarer med horisonten, holder du denne orienteringen.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Wanneer de lijn voor de klimstand overeenkomt met de horizon, handhaaf je die vliegstand.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Gdy linia pochylenia przy wznoszeniu pokryje się z horyzontem, utrzymuj to pochylenie.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Quando a linha de atitude de subida corresponder ao horizonte, mantenha essa atitude.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Quando a linha de atitude de subida corresponder ao horizonte, mantenha essa atitude.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Когда линия набора высоты совпадёт с линией горизонта, сохраняйте это пространственное положение.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "När linjen för stigningsattityden matchar horisonten bibehåller du den attityden.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Tırmanış durumu çizgisi ufukla eşleştiğinde durumunuzu koruyun.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "当爬升姿态线与地平线重合时，保持该姿态。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "70b9756b-7f04-4c4c-9769-d7d1c9616fd5": {
        "Name": "AttitudesPitch.Dlg_PitchUp2",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-10-07 17:36:56",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Allerdings verlieren wir an Fluggeschwindigkeit. Wir sind eben auch beim Aufstieg den Gesetzen der Physik unterworfen.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "But we're losing airspeed. Proving you can't avoid basic physics while making a climb. ",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Pero estamos perdiendo velocidad aerodinámica. Esto demuestra que no puedes ignorar la física básica mientras realizas un ascenso.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Pero estamos perdiendo velocidad aerodinámica. Esto demuestra que no puedes ignorar la física básica mientras realizas un ascenso. ",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Ilmanopeus kuitenkin pienenee. Fysiikan peruslait pätevät myös nousun aikana. ",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Mais nous perdons de la vitesse. Preuve qu'il est impossible de s'affranchir des lois physiques en montée.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Ma stiamo perdendo velocità all'aria. Questa è la dimostrazione che non puoi evitare le leggi della fisica durante la salita. ",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "ですが対気速度は下がりつつあります。上昇中は物理学から逃れられないのです。 ",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "대기속도가 떨어지고 있어요. 상승하는 동안에도 기본적인 물리 법칙이 적용되는 거죠. ",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Vi mister imidlertid airspeed. Det beviser at du ikke kan slippe unna grunnleggende fysikk når du stiger. ",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Maar we verliezen luchtsnelheid. Waarmee wordt bewezen dat je eenvoudige natuurkunde niet kunt vermijden tijdens het opstijgen. ",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Ale tracimy prędkość. To dowodzi, że podczas wznoszenia obowiązują prawa fizyki. ",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Mas estamos perdendo velocidade em relação ao ar. Isso prova que não se pode evitar a física básica enquanto faz uma subida.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Mas estamos a perder velocidade no ar. O que comprova que não se pode evitar a física básica ao fazer uma subida. ",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "При наборе высоты наша воздушная скорость падает, потому что законы физики не обманешь. ",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Men vi tappar fart. Vilket bevisar att fysikens lagar gäller när du stiger. ",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Hava hızımız azalıyor. Bu da tırmanış yaparken temel fizik kurallarından kaçınamayacağınızın kanıtı. ",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "但是我们的空速也在不断下降。这也证明你在处于爬升状态时也不能逃避基本物理法则。 ",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
