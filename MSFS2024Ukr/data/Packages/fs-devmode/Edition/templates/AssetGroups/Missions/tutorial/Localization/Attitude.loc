        "Languages": {
          "de-DE": {
            "Text": "Lernen Sie, das Höhenruder zu verwenden",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Learn to use the elevator",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Aprende a usar el timón de profundidad",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Aprende a usar el timón de profundidad",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Opi käyttämään korkeusperäsintä",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Apprendre à utiliser la gouverne de profondeur",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Impara a usare l'equilibratore",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "エレベーターの使い方",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "엘리베이터 사용법 배우기",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Lær hvordan du bruker høyderoret",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Het hoogteroer leren gebruiken",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Naucz się używać steru wysokości",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Aprenda a usar os profundores",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Aprenda a utilizar o leme de profundidade",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Научитесь пользоваться рулем высоты",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Lär dig att använda höjdroder",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "İrtifa dümenini kullanmayı öğrenin.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "学会使用升降舵",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "ca4b5b44-d1a0-425d-a992-9bf0bd16b05d": {
        "Name": "AttitudesPitch.Dlg_Intro4_1",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2025-03-07 15:41:35",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Ziehen Sie das Steuerhorn sanft zurück, bis die Steigfluglagenlinie mit dem Horizont übereinstimmt,",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Pull back gently on the yoke until the climb attitude line matches the horizon,",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Tira del volante hacia atrás suavemente hasta que la línea de actitud de ascenso coincida con el horizonte,",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Tira del volante hacia atrás suavemente hasta que la línea de actitud de ascenso coincida con el horizonte,",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Vedä varovasti ohjaussauvaa, kunnes horisontti on nousuasentoviivan kohdalla,",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Ramenez légèrement le manche vers vous jusqu'à ce que le trait d'assiette de montée s'aligne sur l'horizon,",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Tira indietro delicatamente la barra fino a quando la linea di assetto di salita non corrisponde all'orizzonte,",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "ヨークをゆっくり引いて上昇姿勢線と地平線を重ね--",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "조종간을 뒤로 부드럽게 당겨 상승 자세 점선을 수평선과 일치시킨 다음,",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Trekk styrespaken forsiktig bakover til linjen for stigningsorientering samsvarer med horisonten,",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Trek de knuppel rustig naar achteren tot de lijn van de klimstand overeenkomt met de horizon,",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Delikatnie ściągnij wolant, aż linia pochylenia przy wznoszeniu pokryje się z horyzontem,",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Cabre o manche suavemente até que a linha de atitude de subida corresponda ao horizonte,",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Cabre a manche suavemente até que a linha de atitude de subida corresponda ao horizonte,",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Мягко возьмите штурвал на себя, пока линия набора высоты не совпадёт с линией горизонта,",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Dra tillbaka styrspaken försiktigt tills linjen för stigningsattityd matchar horisonten",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Tırmanış durumu çizgisi ufukla hizalanana kadar lövyeyi yavaşça geri çekin.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "轻轻拉回控制杆，直至爬升姿态线与地平线重合，",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "ce543754-6f12-461f-93ae-d15d2067919e": {
        "Name": "AttitudesPitch.Dlg_IntroAlternative4",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-10-07 17:36:56",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Die untere gepunktete Linie ist die Steigfluglage und die obere Linie ist die Sinkfluglage.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "The lower dotted line is the climb attitude, and the upper one is the descent attitude.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "La línea de puntos inferior es la actitud de ascenso y la superior es la actitud de descenso.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "La línea de puntos inferior es la actitud de ascenso y la superior es la actitud de descenso.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Alin viiva on nousuasentoviiva, ja yläviiva on vajoamisasennon viiva.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "La ligne en pointillés du bas représente l'assiette de montée et celle du haut, l'assiette de descente.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "La linea tratteggiata inferiore è l'assetto di salita, mentre quella superiore è l'assetto di discesa.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "下の点線は上昇姿勢、上の点線は降下姿勢の基準線です。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "수평선이 아래쪽 점선에 닿으면 상승 자세, 위쪽 점선에 닿으면 하강 자세라고 합니다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Den nederste stiplede linjen er stigningsorienteringen og den øverste er nedstigningsorienteringen.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "De onderste stippellijn is de klimstand, en de bovenste is de daalstand.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Dolna przerywana linia to pochylenie przy wznoszeniu, a górna – pochylenie przy zniżaniu.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "A linha pontilhada inferior é a atitude de subida e a superior é a atitude de descida.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "A linha pontilhada inferior é a atitude de subida e a superior é a atitude de descida.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Нижняя пунктирная линия — это режим набора высоты, а верхняя — режим снижения.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Den undre prickade linjen är stigningsattityden medan den övre är nedstigningsattityden.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Alttaki noktalı çizgi tırmanma durumudur. Üstteki çizgi ise iniş durumudur.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "下面的虚线代表爬升姿态，上面的虚线则代表下降姿态。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "d601ac45-60d8-4aef-831f-cfa895e11367": {
        "Name": "AttitudesPitch.Dlg_IntroAlternative3",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Das ist die Reisefluglage.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "This is the cruise attitude. ",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Esta es la actitud de crucero.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Esta es la actitud de crucero. ",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Tämä on matkalentoasento. ",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Il s'agit de l'assiette de croisière. ",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Questo è l'assetto di crociera.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "これが巡航姿勢です。 ",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "이 상태가 바로 순항 자세입니다. ",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Det er marsjorienteringen. ",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Dit is de kruisvluchtstand. ",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "To jest pochylenie odpowiednie dla prędkości przelotowej. ",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Esta é a atitude de cruzeiro.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Esta é a atitude de cruzeiro.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Это крейсерский режим полёта.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Det är detta som kallas marschattityd. ",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Bu, seyir durumudur. ",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "这就是巡航姿态。 ",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "d14362ef-24ab-4560-a754-86e49765470e": {
        "Name": "BasicInstruments.Failed_Training",
        "Speaker": "INSTRUCTOR",
