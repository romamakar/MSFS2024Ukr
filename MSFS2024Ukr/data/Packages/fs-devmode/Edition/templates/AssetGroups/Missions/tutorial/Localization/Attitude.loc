            "Text": "Você não conseguiu completar a lição.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Não conseguiu completar a lição.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Вам не удалось завершить урок.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Du slutförde inte lektionen.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Dersi tamamlayamadınız.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "你没能完成课程。",
            "LocalizationStatus": "TranslationOk"
          }
        }
