        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Mit {STR_AXIS_ELEVATOR_SET} die Reisefluglagenlinie wieder am Horizont ausrichten",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Place the cruise attitude line back onto the horizon using {STR_AXIS_ELEVATOR_SET}",
