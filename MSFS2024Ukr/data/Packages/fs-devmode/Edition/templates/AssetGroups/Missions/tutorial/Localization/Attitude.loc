      "b2946047-fc35-44e2-983e-2a5de8f0a39c": {
        "Name": "AttitudesPitch.Dlg_IntroAlternative1",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Um zu helfen, ein Gefühl für die Neigung zu entwickeln, habe ich drei Linien auf die Windschutzscheibe gezeichnet.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "To help demonstrate pitch, I've drawn three lines on the windshield.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Para ayudarte a ver el cabeceo, he dibujado tres líneas en el parabrisas.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Dibujé tres líneas en el parabrisas para ayudarte a ver el cabeceo.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Jotta opit tuntemaan nokan asennon, olen vetänyt tuulilasiin kolme viivaa.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Pour vous aider à visualiser, j'ai dessiné trois traits sur le pare-brise.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Per illustrarti bene il beccheggio, ho disegnato tre linee sul parabrezza.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "ピッチを理解する補助として、ウィンドシールドに 3 本の線を引きました。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "피치 설명을 위해 앞유리에 세 개의 선을 그렸습니다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "For å demonstrere hva pitch er, har jeg tegne tre linjer på frontruten.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Om de pitch te demonstreren, heb ik drie lijnen op de voorruit getekend.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Aby pokazać pochylenie, zaznaczam na wiatrochronie trzy linie.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Para ajudar a demonstrar a arfagem, desenhei três linhas no para-brisa.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Para ajudar a demonstrar a arfagem, desenhei três linhas no para-brisas.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Чтобы лучше понять, что такое тангаж, проведём на лобовом стекле три линии.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "För att demonstrera nosläget har jag ritat tre linjer på vindrutan.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Yunuslamayı göstermeye yardımcı olmak için ön cama üç çizgi çizdim.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "为了更好地做俯仰角的演示，我在挡风玻璃上画了三条线。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "c06cedb9-3783-4973-a060-a9e9e8998183": {
        "Name": "AttitudesPitch.Description",
