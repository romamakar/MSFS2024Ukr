      "1c583eca-e4ff-4740-8fb7-6abfb45352d2": {
        "Name": "AttitudesPitch.Step_Plane_Pitch_Down",
        "Comment": "Placeholder refers to an input button from the players chosen controller",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Mit {STR_AXIS_ELEVATOR_SET} die obere Linie am Horizont ausrichten",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Place the upper line onto the horizon using {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Sitúa la línea superior en el horizonte con {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Sitúa la línea superior en el horizonte con {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Vie yläviiva horisontin kohdalle {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Placer la ligne du haut sur l'horizon en utilisant {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Posiziona la linea superiore sull'orizzonte con {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "{STR_AXIS_ELEVATOR_SET} で水平線上に上側のラインを合わせる",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "상단 선을 수평선에 맞게 배치 ({STR_AXIS_ELEVATOR_SET} 사용)",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Plasser den øverste linjen på horisonten ved å bruke {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Plaats de bovenste lijn op de horizon met behulp van {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Ustaw górną linię na horyzoncie za pomocą {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Coloque a linha superior no horizonte usando {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Coloque a linha superior no horizonte ao utilizar {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Совместите верхнюю линию с линией горизонта при помощи {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Positionera den övre linjen på horisonten med {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "{STR_AXIS_ELEVATOR_SET} ile alt çizgiyi ufukla hizalayın",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "按下{STR_AXIS_ELEVATOR_SET}将上方的线置于地平线上",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "1d9b587c-681a-446c-b8a1-98f21e080f86": {
        "Name": "AttitudesPitch.REWARD_LevelOff",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Die Reisefluglagenlinie auf Höhe des Horizonts halten",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Maintain the cruise attitude line on the horizon",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Mantener la línea de actitud de crucero en el horizonte",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Mantener la línea de actitud de crucero en el horizonte",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Pidä matkalentoasentoviiva horisontin kohdalla",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Maintenir la ligne de l'assiette de croisière sur l'horizon",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Mantieni la linea dell'assetto di crociera sull'orizzonte",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "巡航姿勢ラインを水平線上に維持する",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "순항 자세 선을 수평선에 유지",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Hold marsjorienteringslinjen på horisonten",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Houd de kruisvluchthoudingslijn op de horizon",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Utrzymaj linię pochylenia odpowiedniego dla prędkości przelotowej równo z horyzontem",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Mantenha a linha de atitude de cruzeiro no horizonte",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Mantenha a linha de atitude de cruzeiro no horizonte",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Совместите линию крейсерского режима с линией горизонта и сохраняйте это положение",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Håll linjen för marschattityd på horisonten",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Seyir durumu çizgisini ufukta tutun",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "保持巡航姿态线在地平线上",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "2cf22a70-c343-43b8-89b3-475fc6aefb8a": {
        "Name": "AttitudesPitch.Dlg_PitchLevel1Reminder",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Bewegen Sie das Steuerhorn, bis die Reisefluglagenlinie mit dem Horizont übereinstimmt.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Adjust the yoke until the cruise attitude line is level with the horizon.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Ajusta el volante hasta que la línea de actitud de crucero esté nivelada con el horizonte.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Ajusta el volante hasta que la línea de actitud de crucero esté nivelada con el horizonte.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Liikuta ohjaussauvaa, kunnes horisontti on matkalentoasentoviivan kohdalla.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Ajustez le manche jusqu'à ce que la ligne de l'assiette de croisière soit au niveau de l'horizon.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Regola la barra fino a quando la linea di assetto di crociera non è al livello dell'orizzonte.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "巡航姿勢線が地平線に重なるまでヨークを調整します。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "순항 자세 실선이 수평선과 일치할 때까지 조종간을 움직이십시오.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Juster styrespaken til linjen for marsjorientering er innrette med horisonten.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Breng aanpassingen aan de stuurkolom aan tot de lijn voor de kruisvluchthouding op gelijke hoogte is met de horizon.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Poruszając wolantem, ustaw linię pochylenia odpowiedniego dla prędkości przelotowej równo z horyzontem.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Ajuste o manche até que a linha da atitude de cruzeiro esteja nivelada com o horizonte.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Ajuste a manche até que a linha de atitude de cruzeiro esteja nivelada com o horizonte.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Работайте штурвалом до тех пор, пока линия крейсерского режима не совпадёт с линией горизонта.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Justera styrspaken tills linjen för marschattityd är i nivå med horisonten.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Seyir durumu çizgisi ufukla aynı hizaya gelene kadar lövyeyi ayarlayın.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "调整控制杆，直至巡航姿态线与地平线平齐。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "3f1a19f8-7485-4eec-a661-50f89542124a": {
        "Name": "AttitudesPitch.Goal_Plane_Pitch_Up",
        "Comment": "Direction aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-10-07 17:36:56",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Steigen Sie auf",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Pitch up to climb",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Aumenta el cabeceo para ascender",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Aumenta el cabeceo para ascender",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Nosta nokkaa ylös ja nouse",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Cabrer pour monter",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Beccheggio verso l'alto per iniziare la salita",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "ピッチ アップで上昇",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "피치를 높여 상승 자세 형성",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Pitch opp for å stige",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Neus omhoog om te klimmen",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Uniesienie dziobu dla wznoszenia",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Cabre para subir",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Arfe para cima para subir",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Кабрируйте, чтобы набрать высоту",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Höj nosläget för att stiga",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Tırmanmak için yukarı yunuslama yapın",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "向上仰起至爬升姿态",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "07c2eaa9-07d8-40db-b954-2c94810b59b0": {
        "Name": "BasicControls.Dlg_UnexpectedLanding3",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-10-07 17:36:56",
        "LocalizationStatus": "Active",
        "Tags": {
          "Locked": "False"
        },
        "Languages": {
          "de-DE": {
            "Text": "An dieser Stelle wäre es wohl das Beste, wenn wir die Lektion neu beginnen.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "At this point I think it's probably best if we start the lesson over.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Creo que ahora mismo lo mejor sería volver a repetir la lección.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Creo que ahora mismo lo mejor sería volver a repetir la lección.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Tässä vaiheessa on parasta aloittaa oppitunti alusta.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "À ce stade, je pense qu'il serait préférable de recommencer la leçon.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "A questo punto, credo sarebbe meglio se ricominciassimo la lezione da capo.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "ここで教習をやり直すのがベストでしょう。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "이쯤 되면 교습을 다시 시작하는 편이 낫겠네요.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Nå tror jeg det er best om vi starter leksjonen på nytt.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Ik denk dat het nu waarschijnlijk het beste is de les opnieuw te starten.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Chyba najlepiej będzie, jeśli zaczniemy szkolenie od początku.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Sendo assim, acho que seria melhor recomeçarmos a lição.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Nesta altura, acho que seria melhor recomeçarmos a lição.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Поэтому я думаю, что лучше всего начать урок заново.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Vid det här laget är det nog bäst om vi tar om lektionen från början.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Durum böyleyken en iyisi derse baştan başlamak.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "既然这样的话，我觉得不如还是重新开始这节课吧。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "7fd2790e-d391-4c8f-b2d9-151965d1f575": {
        "Name": "AttitudesPitch.Dlg_Feedback_GeneralAttitude_A",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Es ist für alle Arten von Manövern wichtig, eine präzise und stabile Fluglage beibehalten zu können.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Being able to maintain a precise and stable attitude is key to performing all types of maneuvers.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Ser capaz de mantener una actitud precisa y estable es esencial para realizar todo tipo de maniobras.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Ser capaz de mantener una actitud precisa y estable es esencial para realizar todo tipo de maniobras.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Tarkan ja vakaan lentoasennon ylläpitäminen on avainasemassa kaikenlaisissa liikkeissä.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Pour effectuer tous types de manœuvres, il est essentiel de savoir maintenir une assiette stable et précise.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Essere in grado di mantenere un assetto preciso e stabile è fondamentale per eseguire tutti i tipi di manovre.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "正確で安定した姿勢を保つことが、あらゆる空中機動の基本になります。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "다양한 기동을 수행하려면 무엇보다도 정밀하고 안정적인 자세가 중요합니다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Det å kunne opprettholde en presis og stabil orientering er nøkkelen til å utføre alle typer manøvrer.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Het handhaven van een exacte en stabiele vliegstand is de sleutel tot het uitvoeren van alle soorten manoeuvres.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Umiejętność precyzyjnego utrzymywania właściwego pochylenia jest kluczem do prawidłowego wykonywania wszelkich manewrów.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Conseguir manter uma atitude precisa e estável é fundamental para realizar todos os tipos de manobras.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Conseguir manter uma atitude precisa e estável é fundamental para realizar todos os tipos de manobras.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Умение точно удерживать стабильное пространственное положение лежит в основе выполнения всех манёвров.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Nyckeln till att kunna utföra alla typer av manövrar är att kunna upprätthålla en exakt och stabil attityd.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Kesin ve istikrarlı bir uçuş durumunu sürdürebilmek, her türlü manevrayı gerçekleştirmenin anahtarıdır.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "能够保持精准稳定的姿态是执行各种机动动作的关键。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
