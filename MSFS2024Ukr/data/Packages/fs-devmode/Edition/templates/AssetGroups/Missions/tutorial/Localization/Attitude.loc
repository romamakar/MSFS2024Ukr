      "6476c1a7-e9f8-4aae-8c4e-0e37f1468949": {
        "Name": "BasicControls.Dlg_UnexpectedLanding2",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-10-07 17:36:56",
        "LocalizationStatus": "Active",
        "Tags": {
          "Locked": "False"
        },
        "Languages": {
          "de-DE": {
            "Text": "Eine gute Landung, keine Frage. Aber nicht das, was ich erwartet hatte.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "It's well done, don't get me wrong… just not what was expected.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "A ver si me explico: no está mal, pero no es lo que estaba previsto.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "A ver si me explico: no está mal, pero no es lo que estaba previsto.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Hyvä suoritus, älä ymmärrä väärin… ei kuitenkaan mennyt ihan odotetusti.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Je ne vous jette pas la pierre, mais ce n'était pas prévu au programme...",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Non fraintendermi, hai fatto un buon lavoro… ma non era quello che mi aspettavo.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "よくできましたが、予定とは違います...",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "잘하긴 하셨는데… 나쁘게 듣진 마시고, 예상과는 좀 다르네요.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Ikke misforstå meg, det var godt gjort … bare ikke helt som forventet.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Het is goed gedaan, begrijp me niet verkeerd... alleen niet wat er werd verwacht.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Nie zrozum mnie źle, poszło Ci świetnie… ale nie o to chodziło.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Foi bem feito, não me entenda mal… só não foi o que eu esperava.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Está bem feito, não me entenda mal... apenas não o que se esperava.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Поймите правильно… Посадка прошла успешно, но задача была не совсем такой.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Det var bra gjort, missförstå mig rätt … bara inte riktigt vad jag väntade mig.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Yanlış anlamayın, güzeldi. Sadece beklediğim gibi değildi.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "别误会，你做得很好……只是没料到你会这么做。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "8268e5f5-465c-447d-9875-2a5c80f3e223": {
        "Name": "AttitudesPitch.Dlg_PitchDown3",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Wie Sie sehen können, nimmt unsere Höhe ab und unsere Geschwindigkeit zu, wenn die Nase des Flugzeugs nach unten zeigt.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "As expected, with a nose-down attitude, our altitude is decreasing while our speed is picking up.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Como era de esperar, con una actitud de morro hacia abajo, la altitud disminuye mientras que la velocidad aumenta.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Como era de esperar, con una actitud de nariz hacia abajo, la altitud disminuye mientras que la velocidad aumenta.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Kuten odottaa saattaa, korkeus pienenee ja nopeus suurenee nokan ollessa alaspäin.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Comme on s'y attendait, avec une assiette en piqué, notre altitude diminue alors que notre vitesse augmente.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Come previsto, con un assetto discendente del muso, la nostra altitudine diminuisce, mentre la velocità aumenta.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "機首を下げた姿勢を取ると、当然、高度が下がり、速度が上がります。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "하강 자세를 취하니 예상대로 고도가 내려가고 속도가 빨라집니다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Som forventet med orientering med nesen ned, reduseres høyden samtidig som hastigheten øker.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Zoals verwacht, neemt bij een vluchthouding met de neus omlaag onze hoogte af terwijl onze snelheid toeneemt.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Jak można się było spodziewać, przy opuszczonym dziobie nasza wysokość spada, a prędkość rośnie.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Como é de se esperar, com uma atitude de nariz para baixo, nossa altitude diminui enquanto nossa velocidade aumenta.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Como esperado, com uma atitude de nariz para baixo, a nossa altitude está a diminuir enquanto a nossa velocidade aumenta.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Как и ожидалось, при пикировании наша высота уменьшается, а скорость растёт.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Som väntat, med en nosläge-ner-attityd, minskar höjden medan farten ökar.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Tahmin edileceği üzere burun aşağı bir durumda hızımız yükselirken irtifamız azalıyor.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "如同预期，将机头下沉之后，我们的高度已经开始下降，飞机的速度也在提高。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "9538f007-8bad-41a9-91c3-01074aafeafc": {
        "Name": "AttitudesPitch.Dlg_Intro4Reminder1",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-11-27 17:09:49",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Ziehen Sie jetzt sanft das Steuerhorn nach hinten.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Go ahead and gently pull back on the yoke.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Continúa y tira del volante suavemente hacia atrás.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Continúa y tira suavemente el volante hacia atrás.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Vedä ohjaussauvaa varovasti.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Allez-y, tirez doucement sur le manche.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Adesso tira gentilmente indietro la barra.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "では、ヨークをゆっくり引いて。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "이제 조종간을 부드럽게 뒤로 당기십시오.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Sett i gang og trekk styrespaken forsiktig bakover.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Trek de knuppel rustig naar achteren.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Śmiało, delikatnie ściągnij wolant.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Cabre o manche suavemente.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Cabre a manche suavemente.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "А теперь плавно возьмите штурвал на себя.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Dra försiktigt styrspaken mot dig.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Şimdi lövyeyi yavaşça geri çekin.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "试一试吧，轻轻地向后控制杆。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "12633a9e-b2cb-4c36-8501-1614ae897845": {
        "Name": "BasicControls.Dlg_OufOfBound",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Tags": {
          "Locked": "False"
        },
        "Languages": {
          "de-DE": {
            "Text": "Sie haben den Übungsluftraum verlassen, Sie müssen umkehren!",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "You've left the Training airspace, you need to go back.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Has abandonado el espacio aéreo de entrenamiento. Tienes que regresar.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Abandonaste el espacio aéreo de capacitación. Tienes que volver.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Olet poistunut harjoituksen ilmatilasta, sinun täytyy palata.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Vous avez quitté l'espace aérien de formation, vous devez faire demi-tour.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Hai lasciato lo spazio aereo per l'addestramento, devi tornare indietro.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "訓練空域から出てしまいました。戻ってください。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "훈련 공역을 벗어났어요. 복귀해야 합니다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Du har forlatt opplæringsluftrommet, du må dra tilbake.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Je hebt het trainingsluchtruim verlaten, je moet terug.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Opuszczasz strefę lotów szkolnych, musisz zawrócić.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Você saiu do espaço aéreo de treinamento. Você precisa voltar.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Saiu do espaço aéreo de formação. Precisa de voltar.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Вы покинули учебное воздушное пространство. Вернитесь.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Du har lämnat utbildningsluftrummet och måste vända tillbaka.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Eğitim hava sahasından çıktınız. Dönmeniz gerekiyor.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "您已离开训练空域，请您返回。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "43606ba6-8d67-45ee-8a8f-ace78ca81f6d": {
        "Name": "AttitudesPitch.Briefing.ShortBrief",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-12-03 11:46:59",
        "LocalizationStatus": "PlaceHolder",
        "Languages": {
          "de-DE": {
            "Text": "In diesem Tutorial lernen Sie die Grundlagen des Fluglagenmanagements kennen. </br></br> Die Fluglage bezieht sich auf die Position der Nase des Flugzeugs relativ zum Horizont, sei es durch Neigung oder Rolle. </br></br> In der Abbildung rechts stellen die gestrichelten Linien die Position des Horizonts beim Auf- oder Abstieg dar.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "In this tutorial you will learn the basics of attitude management. </br></br> Attitude refers to the aircraft's nose position relative to the horizon, be it through pitch or roll. </br></br> In the image to the right, the lines represent the horizon's position when ascending or descending.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "En este tutorial aprenderás los conceptos básicos para gestionar la actitud. </br></br>La actitud hace referencia a la posición del morro del avión en relación con el horizonte, ya sea mediante cabeceo o balanceo. </br></br>En la imagen a la derecha, las líneas representan la posición del horizonte al ascender o descender.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "En este tutorial aprenderás los conceptos básicos para gestionar la actitud. </br></br>La actitud hace referencia a la posición de la nariz del avión en relación con el horizonte, ya sea mediante cabeceo o balanceo. </br></br>En la imagen a la derecha, las líneas representan la posición del horizonte al ascender o descender.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Tällä oppitunnilla opetellaan lentoasennon hallinnan perusteet. </br></br> Lentoasennolla tarkoitetaan ilma-aluksen kallistusta poikittais- tai pituusakselin ympäri suhteessa horisonttiin. </br></br> Oikealla olevassa kuvassa katkoviivat kuvaavat horisontin paikkaa nousussa ja laskussa.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Dans ce tutoriel, vous apprendrez les bases de la gestion de l'assiette. </br></br> L'assiette désigne l'orientation de l'appareil, latérale ou verticale, par rapport à l'horizon. </br></br> Sur l'image à droite, les lignes représentent la position de l'horizon pendant la montée ou la descente.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "In questo tutorial apprenderai le basi della gestione dell'assetto. </br></br> Con assetto si intende l'orientamento dell'aeromobile rispetto alla linea dell'orizzonte, sia in termini di beccheggio sia di rollio. </br></br> Nell'immagine a destra, le linee tratteggiate rappresentano la posizione dell'orizzonte durante la salita o la discesa.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "このチュートリアルでは、姿勢管理の基本を学習します。</br></br>姿勢とは、ピッチまたはロールによる、水平線に対する航空機の機首の位置を指します。</br></br>右の画像では、線は上昇時または降下時の地平線の位置を表しています。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "이 튜토리얼에서는 자세 관리의 기초를 배우게 됩니다. </br></br> 자세는 수평선을 기준으로 한 항공기의 기수 방향을 말하며 피치 또는 롤을 통해 구사합니다. </br></br> 오른쪽 이미지의 선은 상승 또는 하강할 때 수평선의 위치를 나타냅니다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "I denne opplæringen lærer du det grunnleggende om å holde nesestillingen.</br></br>Nesestillingen indikerer flyets neseposisjon i forhold til horisonten.</br></br>På bildet til høyre representerer de stiplede linjene horisontens posisjon ved stigning eller nedstigning.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "In deze tutorial leer je de basisprincipes van het beheren van de vliegtuigstand. </br></br>Vliegtuigstand verwijst naar de oriëntatie van het vliegtuig ten opzichte van de horizon, of het nu gaat om pitch of rol. </br></br> In de afbeelding rechts geven de lijnen de positie van de horizon weer bij het stijgen of dalen.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "W tym samouczku nauczysz się podstaw sterowania pochyleniem. </br></br> Kąt nachylenia maszyny to pozycja statku powietrznego w stosunku do horyzontu poprzez pochylenie lub przechylenie. </br></br>Linie na obrazie po prawej stronie oznaczają położenie horyzontu podczas wznoszenia lub opadania.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Neste tutorial, você aprenderá os conceitos básicos sobre gerenciamento de atitude. </br></br> Atitude refere-se à posição do nariz da aeronave em relação ao horizonte, seja por meio de arfagem ou rolamento. </br></br> Na imagem à direita, as linhas representam a posição do horizonte durante a ascensão ou descida.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Neste tutorial, vai aprender o essencial sobre a gestão da atitude. </br></br> “Atitude” refere-se à posição do nariz da aeronave relativamente ao horizonte, seja por inclinação ou rolamento. </br></br> Na imagem à direita, as linhas representam a posição do horizonte ao subir ou descer.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "В этом уроке вы узнаете об основах пространственного положения. </br></br> Пространственное положение — это положение носа самолета относительно горизонта по тангажу или по крену. </br></br> Линии на изображении справа обозначают положение горизонта при подъеме или снижении.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "I den här handledningen får du lära dig grunderna i attitydhantering.</br></br>Attityd avser flygplanets nosposition i förhållande till horisonten.</br></br>I bilden till höger representerar linjerna horisontens position vid upp- eller nedstigning.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Bu eğitimde durum yönetiminin temellerini öğreneceksiniz. </br></br> Durum, hava aracının ufka göre olan yunuslama veya tono hareketini gösterir. </br></br> Sağdaki görüntüde kesikli çizgiler, tırmanış veya iniş sırasında ufkun konumunu temsil eder.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "在本教程中，你将学习姿态管理的基础知识。</br></br>姿态是指飞机相对于地平线的方向，无论是通过俯仰还是横滚。</br></br>在右侧的图像中，虚线表示爬升或下降时地平线的位置。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "76596d29-deb8-442a-a1cf-644710a39420": {
        "Name": "AttitudesPitch.Step_Maintain_Pitch_Down",
        "Comment": "Placeholder refers to an input button from the players chosen controller",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Mit {STR_AXIS_ELEVATOR_SET} die obere Linie 10 Sekunden auf dem Horizont halten",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Maintain the upper line onto the horizon for 10 seconds using {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Mantén la línea superior en el horizonte durante 10 segundos con {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Mantén la línea superior en el horizonte durante 10 segundos con {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Pidä yläviiva horisontin kohdalla 10 sekunnin ajan {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Maintenir la ligne du haut sur l'horizon pendant 10 secondes en utilisant {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Mantieni la linea superiore sull'orizzonte per 10 secondi con {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "{STR_AXIS_ELEVATOR_SET} で水平線上に上側のラインを 10 秒間維持する",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "상단 선을 10초 동안 수평선에 유지 ({STR_AXIS_ELEVATOR_SET} 사용)",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Hold den øverste linjen på horisonten i 10 sekunder ved å bruke {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Houd de bovenste lijn gedurende 10 seconden op de horizon geplaatst met behulp van {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Utrzymaj górną linię na horyzoncie przez 10 sekund za pomocą {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Mantenha a linha superior no horizonte por 10 segundos usando {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Mantenha a linha superior no horizonte por 10 segundos ao utilizar {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Удерживайте верхнюю линию на уровне горизонта в течение 10 секунд с помощью {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Håll den övre linjen på horisonten i 10 sekunder med {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "{STR_AXIS_ELEVATOR_SET} kullanarak üst çizgiyi 10 saniye boyunca ufukla aynı hizada tutun.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "按下{STR_AXIS_ELEVATOR_SET}将上方的线保持在地平线上10秒钟",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
