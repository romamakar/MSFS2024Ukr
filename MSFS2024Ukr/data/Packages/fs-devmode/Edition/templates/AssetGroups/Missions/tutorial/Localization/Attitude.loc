      "86e17e24-7373-406d-92b7-2ac07c0c033e": {
        "Name": "AttitudesPitch.Dlg_IntroAlternative5",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Schauen wir uns an, was das bedeutet. ",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Let's dig deeper into what that means. ",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Vamos a centrarnos en lo que eso significa. ",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Profundicemos en lo que esto significa. ",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Katsotaan tarkemmin, mitä se tarkoittaa. ",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Je vais vous expliquer plus en détail ce que cela signifie. ",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Approfondiamo ciò che significa.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "詳しく説明しましょう。 ",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "지금부터 무슨 뜻인지 자세히 알아보죠. ",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "La oss se litt nærmere på hva det betyr. ",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Laten we eens nader kijken wat dit inhoudt. ",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Zobaczmy, co to oznacza. ",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Vamos entender bem o significado disso.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Vamos entender bem o significado disso.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Давайте разберёмся с этим поподробнее. ",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Låt oss kika närmare på vad det betyder. ",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Bunun ne anlama geldiğini daha ayrıntılı inceleyelim. ",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "让我们进一步深入探讨这些都意味着什么。 ",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "91e821b6-4e7b-4f66-8632-c65cd42e5621": {
        "Name": "AttitudesPitch.Dlg_Feedback_Stability_B",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-11-27 17:09:49",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Passen Sie die Neigung immer nur ganz leicht an, um nicht zu übersteuern.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Try to make only small adjustments to your pitch, to avoid overcorrection.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Intenta realizar solo pequeños ajustes en tu cabeceo para evitar la sobrecorrección.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Intenta realizar solo pequeños ajustes en tu cabeceo para evitar la sobrecorrección.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Yritä tehdä vain pieniä säätöjä kallistusasentoon, jotta vältetään ylikorjaus.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Essayez de n'effectuer que de petits ajustements pour éviter la surcorrection.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Cerca di apportare solo piccole regolazioni al tuo beccheggio, onde evitare sovracompensazioni.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "やりすぎないよう、ピッチは小さく調整することを心がけてください。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "과도한 수정조작을 피하려면 피치를 미세하게 조정하십시오.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Prøv å bare gjøre små justeringer på pitchen din, for å unngå overkorrigering.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Probeer je pitch slechts licht aan te passen om overcorrectie te voorkomen.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Staraj się zmieniać pochylenie delikatnie, żeby nie przesadzić.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Tente fazer apenas pequenos ajustes na arfagem para evitar uma correção excessiva.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Tente fazer apenas pequenos ajustes na arfagem para evitar uma correção excessiva.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Постарайтесь изменять тангаж небольшими шагами, чтобы избежать избыточной коррекции.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Försök att bara göra små justeringar av nosläget för att undvika överkorrigering.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Aşırı düzeltmeden kaçınmak için yunuslamanıza yalnızca ufak düzeltmeler yapın",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "在调整俯仰角时尽量只做微调，以避免过校正。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "439c7466-4206-4b59-a235-d2d6c2d1e09c": {
        "Name": "AttitudesPitch.Briefing",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-12-03 11:46:59",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "In diesem Tutorial lernen Sie die Grundlagen des Fluglagenmanagements kennen. </br></br> Die Fluglage bezieht sich auf die Position der Nase des Flugzeugs relativ zum Horizont, sei es durch Neigung oder Rolle. </br></br> In der Abbildung rechts stellen die gestrichelten Linien die Position des Horizonts beim Auf- oder Abstieg dar.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "In this tutorial you will learn the basics of attitude management. </br></br> Attitude refers to the aircraft's nose position relative to the horizon, be it through pitch or roll. </br></br> In the image to the right, the lines represent the horizon's position when ascending or descending.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "En este tutorial aprenderás los conceptos básicos para gestionar la actitud. </br></br>La actitud hace referencia a la posición del morro del avión en relación con el horizonte, ya sea mediante cabeceo o balanceo. </br></br>En la imagen a la derecha, las líneas representan la posición del horizonte al ascender o descender.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "En este tutorial aprenderás los conceptos básicos para gestionar la actitud. </br></br>La actitud hace referencia a la posición de la nariz del avión en relación con el horizonte, ya sea mediante cabeceo o balanceo. </br></br>En la imagen a la derecha, las líneas representan la posición del horizonte al ascender o descender.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Tällä oppitunnilla opetellaan lentoasennon hallinnan perusteet. </br></br> Lentoasennolla tarkoitetaan ilma-aluksen kallistusta poikittais- tai pituusakselin ympäri suhteessa horisonttiin. </br></br> Oikealla olevassa kuvassa katkoviivat kuvaavat horisontin paikkaa nousussa ja laskussa.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Dans ce tutoriel, vous apprendrez les bases de la gestion de l'assiette. </br></br> L'assiette désigne l'orientation de l'appareil, latérale ou verticale, par rapport à l'horizon. </br></br> Sur l'image à droite, les lignes représentent la position de l'horizon pendant la montée ou la descente.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "In questo tutorial apprenderai le basi della gestione dell'assetto. </br></br> Con assetto si intende l'orientamento dell'aeromobile rispetto alla linea dell'orizzonte, sia in termini di beccheggio sia di rollio. </br></br> Nell'immagine a destra, le linee tratteggiate rappresentano la posizione dell'orizzonte durante la salita o la discesa.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "このチュートリアルでは、姿勢管理の基本を学習します。</br></br>姿勢とは、ピッチまたはロールによる、水平線に対する航空機の機首の位置を指します。</br></br>右の画像では、線は上昇時または降下時の地平線の位置を表しています。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "이 튜토리얼에서는 자세 관리의 기초를 배우게 됩니다. </br></br> 자세는 수평선을 기준으로 한 항공기의 기수 방향을 말하며 피치 또는 롤을 통해 구사합니다. </br></br> 오른쪽 이미지의 선은 상승 또는 하강할 때 수평선의 위치를 나타냅니다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "I denne opplæringen lærer du det grunnleggende om å holde nesestillingen.</br></br>Nesestillingen indikerer flyets neseposisjon i forhold til horisonten.</br></br>På bildet til høyre representerer de stiplede linjene horisontens posisjon ved stigning eller nedstigning.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "In deze tutorial leer je de basisprincipes van het beheren van de vliegtuigstand. </br></br>Vliegtuigstand verwijst naar de oriëntatie van het vliegtuig ten opzichte van de horizon, of het nu gaat om pitch of rol. </br></br> In de afbeelding rechts geven de lijnen de positie van de horizon weer bij het stijgen of dalen.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "W tym samouczku nauczysz się podstaw sterowania pochyleniem. </br></br> Kąt nachylenia maszyny to pozycja statku powietrznego w stosunku do horyzontu poprzez pochylenie lub przechylenie. </br></br>Linie na obrazie po prawej stronie oznaczają położenie horyzontu podczas wznoszenia lub opadania.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Neste tutorial, você aprenderá os conceitos básicos sobre gerenciamento de atitude. </br></br> Atitude refere-se à posição do nariz da aeronave em relação ao horizonte, seja por meio de arfagem ou rolamento. </br></br> Na imagem à direita, as linhas representam a posição do horizonte durante a ascensão ou descida.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Neste tutorial, vai aprender o essencial sobre a gestão da atitude. </br></br> “Atitude” refere-se à posição do nariz da aeronave relativamente ao horizonte, seja por inclinação ou rolamento. </br></br> Na imagem à direita, as linhas representam a posição do horizonte ao subir ou descer.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "В этом уроке вы узнаете об основах пространственного положения. </br></br> Пространственное положение — это положение носа самолета относительно горизонта по тангажу или по крену. </br></br> Линии на изображении справа обозначают положение горизонта при подъеме или снижении.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "I den här handledningen får du lära dig grunderna i attitydhantering.</br></br>Attityd avser flygplanets nosposition i förhållande till horisonten.</br></br>I bilden till höger representerar linjerna horisontens position vid upp- eller nedstigning.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Bu eğitimde durum yönetiminin temellerini öğreneceksiniz. </br></br> Durum, hava aracının ufka göre olan yunuslama veya tono hareketini gösterir. </br></br> Sağdaki görüntüde kesikli çizgiler, tırmanış veya iniş sırasında ufkun konumunu temsil eder.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "在本教程中，你将学习姿态管理的基础知识。</br></br>姿态是指飞机相对于地平线的方向，无论是通过俯仰还是横滚。</br></br>在右侧的图像中，虚线表示爬升或下降时地平线的位置。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "721dbc74-804b-4acf-853c-6753f2519af6": {
        "Name": "AttitudesPitch.REWARD_PitchUpToClimb",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Die untere Linie auf Höhe des Horizonts halten",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Maintain the lower line on the horizon",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Mantén la línea inferior en el horizonte",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Mantén la línea inferior en el horizonte",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Pidä alaviiva horisontin kohdalla",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Maintenir la ligne du bas sur l'horizon",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Mantieni la linea inferiore sull'orizzonte",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "下側のラインを水平線上に維持する",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "하단 선을 수평선에 유지",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Hold den nederste linjen på horisonten",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Houd de onderste lijn op de horizon",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Utrzymuj dolną linię równo z horyzontem",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Mantenha a linha inferior no horizonte",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Mantenha a linha inferior no horizonte",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Удерживайте нижнюю линию на уровне горизонта",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Håll den nedre linjen på horisonten",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Alt çizgiyi ufukta tutun",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "保持下方的线在地平线上",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "3507a84a-0b1e-4435-860f-cd83e189d66b": {
        "Name": "BasicControls.Dlg_UnexpectedLanding1",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Tags": {
          "Locked": "False"
        },
        "Languages": {
          "de-DE": {
            "Text": "Oh, hier sollten Sie eigentlich nicht landen.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Hmm, you weren't really supposed to land there.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Vaya, se suponía que no tenías que aterrizar ahí.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Hmm, no se suponía que aterrizaras ahí.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Hmm, sinun ei pitänyt laskeutua tuonne.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Euh... vous n'étiez pas censé atterrir ici.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Mh, non era lì che dovevi atterrare.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "うーん、そこに着陸するのは違いますね。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "흠. 원래 착륙할 장소는 그쪽이 아닌데 말이죠.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Hm, du skulle egentlig ikke lande der.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Hmm, het was niet de bedoeling dat je daar zou landen.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Hmm, to nie tutaj należało wylądować.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Hum, na verdade, não era para você pousar aí.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Hum, na verdade, não era para aterrar lá.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Хм, вообще мы с вами не планировали приземляться здесь.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Hmm, det var inte riktigt meningen att du skulle landa där.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Hımm, aslında oraya inmemeniz gerekiyordu.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "嗯，你好像不太应该那里降落。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "5384afcd-bcfb-4d76-af81-9a47fb2dbcf9": {
        "Name": "AttitudesPitch.Dlg_PitchDown2_2",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-11-27 17:09:49",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "und behalten Sie dann diese Fluglage bei.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "then maintain that attitude.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "después mantén esa actitud.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "después mantén esa actitud.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "ja pidä tuo lentoasento.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "puis maintenez-la.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "quindi mantieni quell'assetto.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "-- その姿勢を維持します。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "자세를 그대로 유지하세요.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "deretter holder du denne orienteringen.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "en handhaaf die vliegstand.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "a potem utrzymuj to pochylenie.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "em seguida, mantenha essa atitude.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "em seguida, mantenha essa atitude.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Сохраняйте это пространственное положение.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "och bibehåll sedan den attityden.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Sonrasında durumu koruyun.",
