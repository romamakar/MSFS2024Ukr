          },
          "pt-BR": {
            "Text": "Você não pode realizar este treinamento na vista externa.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Não pode realizar este treino em vista exterior.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Этот урок нельзя пройти в режиме внешней камеры.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Du kan inte utföra den här utbildningen i extern vy.",
            "LocalizationStatus": "TranslationOk"
