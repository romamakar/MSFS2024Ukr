      "d78841fe-0b68-486c-9cd0-b517fbc13680": {
        "Name": "AttitudesPitch.Dlg_PitchDown2_1",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-11-27 17:09:49",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Drücken Sie das Steuerhorn sanft nach vorn, bis die Sinkfluglagenlinie mit dem Horizont übereinstimmt,",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Push gently on the yoke until the descent attitude line matches the horizon,",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Empuja el volante suavemente hasta que la línea de actitud de descenso coincida con el horizonte,",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Empuja el volante suavemente hasta que la línea de actitud de descenso coincida con el horizonte,",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Työnnä varovasti ohjaussauvaa, kunnes horisontti on vajoamisasentoviivan kohdalla,",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Poussez légèrement le manche jusqu'à ce que la ligne d'assiette de descente s'aligne sur l'horizon,",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Spingi delicatamente la barra fino a quando la linea di assetto di discesa non corrisponde all'orizzonte,",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "ヨークをゆっくり押して降下姿勢線と地平線を重ね--",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "조종간을 앞으로 부드럽게 밀어 하강 자세 점선을 수평선과 일치시킨 다음,",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Skyv forsiktig på styrespaken til linjen for nedstigningsorienteringen samsvarer med horisonten,",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Duw de knuppel rustig naar voren totdat de lijn voor de daalstand overeenkomt met de horizon,",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Delikatnie odepchnij wolant, aż linia pochylenia przy zniżaniu pokryje się z horyzontem,",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Pique o manche suavemente até que a linha da atitude de descida corresponda ao horizonte,",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Pique a manche suavemente até que a linha da atitude de descida corresponda ao horizonte,",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Мягко дайте штурвал от себя, пока линия снижения не совпадёт с линией горизонта.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Tryck styrspaken försiktigt framåt tills linjen för nedstigningsattityden matchar horisonten",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "İniş durumu çizgisi ufukla hizalanana kadar lövyeyi yavaşça itin.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "轻轻向上推动控制杆，直到下降姿态线与地平线重合，",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "e4771816-4b33-4348-8638-3c49c8fe31a6": {
        "Name": "AttitudesPitch.Dlg_PitchLevel3Reminder",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Jetzt bitte wieder gerade ausrichten.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "You can level us back out now.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Ahora puedes volver al vuelo uniforme.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Ahora puedes volver al vuelo uniforme.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Voit nyt siirtyä vaakalentoasentoon.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Vous pouvez revenir vers la position initiale, maintenant.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Ora puoi raddrizzare l'aeromobile.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "水平飛行に戻して結構です。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "다시 수평 비행을 유지합시다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Du kan rette oss opp igjen nå.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Je kunt ons nu weer terugbrengen naar horizontale vlucht.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Teraz możesz wyrównać.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Você pode nos nivelar de volta agora.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Pode voltar a nivelar-nos agora.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Теперь давайте выровняем самолёт.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Du kan plana ut igen nu.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Şimdi bizi tekrar düz uçuş durumuna getirebilirsiniz.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "现在你可以把我们重新拉回至水平了。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "f0c5ce37-226a-4a1c-a4af-4d13a9d0d178": {
