      "aa96f973-7ceb-4c0b-b3c9-bd2b27331357": {
        "Name": "AttitudesPitch.Dlg_PitchUp1",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Wie Sie auf dem Höhenmesser ablesen können, beginnen wir an Höhe zu gewinnen.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "According to your Altimeter, we're gaining Altitude.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Como puedes ver en el altímetro, estamos ganando altitud.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Como puedes ver en el altímetro, estamos ganando altitud.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Korkeusmittarin mukaan olemme nousemassa.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "L'altimètre indique que nous gagnons en altitude.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Secondo quanto dice l'altimetro, stiamo guadagnando altitudine.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "高度計によると、機体の高度は上がっています。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "고도계를 보면 위로 상승하고 있죠?",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Ifølge høydemåleren stiger vi.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Volgens je hoogtemeter winnen we hoogte.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Wysokościomierz pokazuje, że nabieramy wysokości.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "De acordo com seu altímetro, estamos ganhando altitude.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "De acordo com o seu Altímetro, estamos a ganhar altitude.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Судя по вашему высотомеру, мы набираем высоту.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Enligt höjdmätaren tar vi höjd.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Altimetrenize göre İrtifa kazanıyoruz.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "通过高度表可以看到，我们的高度正在上升。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "ad6415f2-b809-4bd7-9420-2a567a6606a8": {
        "Name": "AttitudesPitch.Dlg_PitchLevel2",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Unsere Geschwindigkeit steigt und unsere Flughöhe bleibt stabil.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Our speed is increasing and our altitude is stable.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Nuestra velocidad está aumentando y nuestra altitud es estable.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Nuestra velocidad está aumentando y nuestra altitud es estable.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Nopeutemme kasvaa ja korkeutemme on vakaa.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Notre vitesse augmente et notre altitude est stable.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "La nostra velocità sta aumentando e l'altitudine è stabile.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "速度は上がりつつあり、高度は安定しています。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "속도가 증가하고 있으며 고도도 안정적입니다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Hastigheten vår øker og høyden vår er stabil.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Onze snelheid neemt toe en onze hoogte is stabiel.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Nasza prędkość rośnie, a wysokość jest stała.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "A velocidade está aumentando e nossa altitude está estável.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "A velocidade está a aumentar e a nossa altitude está estável.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Наша скорость растёт, а высота не меняется.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Farten ökar och höjden är stabil.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Hızımız artıyor ve irtifamız sabit.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "我们的速度在增加，高度保持稳定。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "af67a665-97f4-4c12-ad64-38c9cf1dc853": {
        "Name": "AttitudesPitch.Prerequisite1",
