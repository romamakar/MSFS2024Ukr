          },
          "es-ES": {
            "Text": "Sitúa la línea de actitud de crucero en el horizonte nuevamente con {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Sitúa la línea de actitud de crucero en el horizonte nuevamente con {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Vie matkalentoasentoviiva takaisin horisontin kohdalle {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Replacer la ligne de l'assiette de croisière du haut sur l'horizon en utilisant {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Posiziona nuovamente la linea dell'assetto di crociera sull'orizzonte con {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "{STR_AXIS_ELEVATOR_SET} で水平線上に巡航姿勢ラインを戻す",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "순항 자세 선을 수평선에 맞게 되돌리기 ({STR_AXIS_ELEVATOR_SET} 사용)",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Plasser linjen for marsjorienteringen tilbake på horisonten ved å bruke {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Plaats de lijn voor de kruisvluchthouding terug op de horizon met behulp van {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Ustaw linię pochylenia odpowiedniego dla prędkości przelotowej na horyzoncie za pomocą {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Coloque a linha de atitude de cruzeiro de volta ao horizonte usando {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Coloque a linha de atitude de cruzeiro de volta ao horizonte ao utilizar {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Снова совместите линию крейсерского режима с линией горизонта при помощи {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Positionera linjen för marschattityd på horisonten igen med {STR_AXIS_ELEVATOR_SET}",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "{STR_AXIS_ELEVATOR_SET} ile seyir durumu çizgisini ufukla tekrar hizalayın",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "按下{STR_AXIS_ELEVATOR_SET}将巡航姿态线置于地平线上",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "f8e520ac-4f56-4374-b120-a7dcdcfdfa92": {
        "Name": "AttitudesPitch.Dlg_PitchLevel3",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Okay, bringen Sie uns wieder in die gerade Position.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Okay, bring us back to level flight.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Vale, volvamos al vuelo uniforme.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Bien, nivela el vuelo de nuevo.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "No niin, siirry takaisin vaakalentoasentoon.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "OK, revenez en vol en palier.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Ok, torniamo al volo orizzontale.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "水平飛行に戻してください。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "자, 이제 수평 비행으로 복귀합시다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "OK, gjør slik at vi flyr rett igjen.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Oké, breng ons terug naar horizontale vlucht.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Dobrze, wyrównaj lot do poziomu.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Certo, nos leve de volta ao voo nivelado.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Ok, traga-nos de volta ao voo nivelado.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Так, а теперь вернёмся к горизонтальному полёту.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Okej, återgå till planflykt.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Şimdi bizi tekrar düz uçuş durumuna getirin.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "好了，把我们再拉回水平飞行。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "febe86c9-a0b4-439d-b1ea-f075a8d05dc7": {
        "Name": "AttitudesPitch.Dlg_PitchLevel4",
        "Comment": "VO TTS aviation instruction",
        "Speaker": "INSTRUCTOR",
        "LastModifiedBy": "pzochalves",
        "LastModifiedDate": "2024-09-06 16:33:45",
        "LocalizationStatus": "Active",
        "Languages": {
          "de-DE": {
            "Text": "Nun wird Ihre Geschwindigkeit reduziert, und Ihre Höhe ist stabil.",
            "LocalizationStatus": "TranslationOk"
          },
          "en-US": {
            "Text": "Now your speed is decreasing, and your altitude is stable.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "es-ES": {
            "Text": "Ahora tu velocidad está disminuyendo y tu altitud es estable.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Ahora tu velocidad está disminuyendo y tu altitud es estable.",
            "LocalizationStatus": "TranslationOk"
          },
          "fi-FI": {
            "Text": "Nyt nopeus pienenee, ja korkeus pysyy samana.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Maintenant, votre vitesse est réduite et votre altitude est stable.",
            "LocalizationStatus": "TranslationOk"
          },
          "it-IT": {
            "Text": "Ora la tua velocità sta diminuendo, mentre l'altitudine è stabile.",
            "LocalizationStatus": "TranslationOk"
          },
          "ja-JP": {
            "Text": "現在、速度は下がり、高度は安定しています。",
            "LocalizationStatus": "TranslationOk"
          },
          "ko-KR": {
            "Text": "속도도 느려지고 고도도 안정화되고 있습니다.",
            "LocalizationStatus": "TranslationOk"
          },
          "nb-NO": {
            "Text": "Nå reduseres hastigheten og høyden er stabil.",
            "LocalizationStatus": "TranslationOk"
          },
          "nl-NL": {
            "Text": "Nu daalt je snelheid en blijft je hoogte gelijk.",
            "LocalizationStatus": "TranslationOk"
          },
          "pl-PL": {
            "Text": "Teraz prędkość maleje, a wysokość jest stała.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-BR": {
            "Text": "Agora sua velocidade está diminuindo e sua altitude está estável.",
            "LocalizationStatus": "TranslationOk"
          },
          "pt-PT": {
            "Text": "Agora a sua velocidade está a diminuir e a sua altitude está estável.",
            "LocalizationStatus": "TranslationOk"
          },
          "ru-RU": {
            "Text": "Теперь ваша скорость снижается, а высота стабильна.",
            "LocalizationStatus": "TranslationOk"
          },
          "sv-SE": {
            "Text": "Nu minskar hastigheten och höjden är stabil.",
            "LocalizationStatus": "TranslationOk"
          },
          "tr-TR": {
            "Text": "Artık hızınız azalıyor ve irtifanız sabit.",
            "LocalizationStatus": "TranslationOk"
          },
          "zh-CN": {
            "Text": "现在你的速度正在下降，高度保持稳定。",
            "LocalizationStatus": "TranslationOk"
          }
        }
      }
    }
  }
}