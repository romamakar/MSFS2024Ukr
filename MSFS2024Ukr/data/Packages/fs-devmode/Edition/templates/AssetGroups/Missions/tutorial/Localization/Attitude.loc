          },
          "fi-FI": {
            "Text": "Et suorittanut oppituntia loppuun.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Vous n'avez pas réussi à terminer la leçon.",
            "LocalizationStatus": "TranslationOk"
