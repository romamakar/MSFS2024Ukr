{
  "LocalisationPackage": {
    "Language": "ru-RU",
    "Strings": {
      "IFRNAV1.Briefing": "Освойте безцінну навичку польоту приладами. Ви навчитеся набирати висоту і знижуватися, орієнтуючись тільки на прилади в кабіні.",
      "IFRNAV1.BriefingBg_Altimeter": "Висотомір",
      "IFRNAV1.BriefingBg_Altitude": "Абсолютна висота",
      "IFRNAV1.BriefingBg_AttitudeIndicator": "Вказівник просторового положення",
      "IFRNAV1.BriefingBg_PFD": "Основний пілотажний дисплей (PFD)",
      "IFRNAV1.BriefingBg_PFD_2": "Основний пілотажний дисплей (PFD)",
      "IFRNAV1.BriefingBg_VSI": "Індикатор вертикальної швидкості (VSI)",
      "IFRNAV1.BriefingBg_VerticalSpeed": "Вертикальна швидкість",
      "IFRNAV1.Dlg_Altitude4000ft_Fail": "Ви не зуміли зберегти висоту 4000 футів. ",
      "IFRNAV1.Dlg_Altitude4000ft_Fail_MALE": "Ви не зуміли зберегти висоту 4000 футів. ",
      "IFRNAV1.Dlg_Altitude4500ft_Fail": "Ви не зуміли втримати висоту 4500 футів. ",
      "IFRNAV1.Dlg_Altitude4500ft_Fail_MALE": "Ви не зуміли втримати висоту 4500 футів. ",
      "IFRNAV1.Dlg_Altitude4500ft_Reminder": "Слідкуйте за висотою. Нам потрібно зберігати 4500 футів. ",
      "IFRNAV1.Dlg_Altitude4500ft_Reminder_MALE": "Слідкуйте за висотою. Нам потрібно зберігати 4500 футів. ",
      "IFRNAV1.Dlg_Descend4000ft1": "Так, а тепер знизимося до 4000 футів, зберігаючи колишній курс. ",
      "IFRNAV1.Dlg_Descend4000ft1_MALE": "Так, а тепер знизимося до 4000 футів, зберігаючи колишній курс. ",
      "IFRNAV1.Dlg_Descend4000ft2": "Зменшіть потужність двигуна, щоб знизитись без збільшення швидкості. ",
      "IFRNAV1.Dlg_Descend4000ft2_MALE": "Зменшіть потужність двигуна, щоб знизитись без збільшення швидкості. ",
      "IFRNAV1.Dlg_FullPowerClimb": "Утримуючи курс 270, дайте повний газ і наберіть висоту 4500 футів.",
      "IFRNAV1.Dlg_FullPowerClimb_MALE": "Утримуючи курс 270, дайте повний газ і наберіть висоту 4500 футів.",
      "IFRNAV1.Dlg_IncreasePower_Reminder": "Знову збільште потужність, щоб не надто сильно втрачати швидкість.",
      "IFRNAV1.Dlg_IncreasePower_Reminder_MALE": "Знову збільште потужність, щоб не надто сильно втрачати швидкість.",
      "IFRNAV1.Dlg_InstrumentView1": "Ми увійшли до шару хмар. Зверніть увагу, як погіршується видимість.",
      "IFRNAV1.Dlg_InstrumentView1_MALE": "Ми увійшли до шару хмар. Зверніть увагу, як погіршується видимість.",
      "IFRNAV1.Dlg_InstrumentView2": "Замість того, щоб намагатися побачити щось зовні, зосередьтеся на приладах у кабіні.",
      "IFRNAV1.Dlg_InstrumentView2_MALE": "Замість того, щоб намагатися побачити щось зовні, зосередьтеся на приладах у кабіні.",
      "IFRNAV1.Dlg_InstrumentView3": "Щоб уникнути крену, слідкуйте за вказівником просторового положення.",
      "IFRNAV1.Dlg_InstrumentView3_MALE": "Щоб уникнути крену, слідкуйте за вказівником просторового положення.",
      "IFRNAV1.Dlg_InstrumentView4": "Продовжуйте набирати висоту 4500 футів. ",
      "IFRNAV1.Dlg_InstrumentView4_MALE": "Продовжуйте набирати висоту 4500 футів. ",
      "IFRNAV1.Dlg_Intro1": "Прямо під нами, під товстим шаром хмар, територія Великобританії - Шетландські острови.",
      "IFRNAV1.Dlg_Intro1_MALE": "Прямо під нами, під товстим шаром хмар, територія Великобританії - Шетландські острови.",
      "IFRNAV1.Dlg_Intro2": "До цього моменту ви могли просто подивитися назовні, щоб оцінити просторове положення повітряного судна та околиці.",
      "IFRNAV1.Dlg_Intro2_MALE": "До цього моменту ви могли просто подивитися назовні, щоб оцінити просторове положення повітряного судна та околиці.",
      "IFRNAV1.Dlg_Intro3": "Але що робити, якщо зовні нічого не видно? І тут доводиться йти приладами.",
      "IFRNAV1.Dlg_Intro3_MALE": "Але що робити, якщо зовні нічого не видно? І тут доводиться йти приладами.",
      "IFRNAV1.Dlg_Intro4": "Якщо ви не можете використовувати горизонт як опорну точку через хмарність, темряву або інші фактори, що ускладнюють видимість, розраховувати залишається тільки на прилади.",
      "IFRNAV1.Dlg_Intro4_MALE": "Якщо ви не можете використовувати горизонт як опорну точку через хмарність, темряву або інші фактори, що ускладнюють видимість, розраховувати залишається тільки на прилади.",
      "IFRNAV1.Dlg_Intro5": "Якщо ви летите по приладах, вам слід стежити за вказівником просторового положення. На ньому відображаються тангаж та крен повітряного судна.",
      "IFRNAV1.Dlg_Intro5_MALE": "Якщо ви летите по приладах, вам слід стежити за вказівником просторового положення. На ньому відображаються тангаж та крен повітряного судна.",
      "IFRNAV1.Dlg_Intro6": "У сучасних кабінах на кшталт тієї, де ви зараз перебуваєте, кілька приладів об'єднані на одному електронному дисплеї. Це основний пілотажний дисплей - він же PFD.",
      "IFRNAV1.Dlg_Intro6_MALE": "У сучасних кабінах на кшталт тієї, де ви зараз перебуваєте, кілька приладів об'єднані на одному електронному дисплеї. Це основний пілотажний дисплей - він же PFD.",
      "IFRNAV1.Dlg_KeepHeading270_Fail": "Ви не в змозі зберегти курс 270.",
      "IFRNAV1.Dlg_KeepHeading270_Fail_MALE": "Ви не в змозі зберегти курс 270.",
      "IFRNAV1.Dlg_KeepHeading270_Reminder": "Слідкуйте за напрямком та утримуйте курс 270. ",
      "IFRNAV1.Dlg_KeepHeading270_Reminder_MALE": "Слідкуйте за напрямком та утримуйте курс 270. ",
      "IFRNAV1.Dlg_LevelOut4000ft": "Чудово! Знову збільште потужність і летіть на крейсерській швидкості, зберігаючи висоту 4000 футів. ",
      "IFRNAV1.Dlg_LevelOut4000ft_MALE": "Чудово! Знову збільште потужність і летіть на крейсерській швидкості, зберігаючи висоту 4000 футів. ",
      "IFRNAV1.Dlg_LevelOut4500ft1": "Орієнтуючись на індикатор вертикальної швидкості та висотомір, вирівняйте літак на висоті 1370 м (4500 футів), зберігаючи курс 270.",
      "IFRNAV1.Dlg_LevelOut4500ft1_MALE": "Орієнтуючись на індикатор вертикальної швидкості та висотомір, вирівняйте літак на висоті 1370 м (4500 футів), зберігаючи курс 270.",
      "IFRNAV1.Dlg_LevelOut4500ft2": "Тепер летить прямо, зберігаючи висоту 1370 м (4500 футів). Ваше завдання – звикнути до відсутності візуальних орієнтирів зовні.",
      "IFRNAV1.Dlg_LevelOut4500ft2_MALE": "Тепер летить прямо, зберігаючи висоту 1370 м (4500 футів). Ваше завдання – звикнути до відсутності візуальних орієнтирів зовні.",
      "IFRNAV1.Dlg_Outro1": "Ось як виглядає зміна висоти при польоті приладами.",
      "IFRNAV1.Dlg_Outro1_MALE": "Ось як виглядає зміна висоти при польоті приладами.",
      "IFRNAV1.Dlg_Outro2": "Згодом ви до цього звикнете. Тепер перейдемо до розворотів.",
      "IFRNAV1.Dlg_Outro2_MALE": "Згодом ви до цього звикнете. Тепер перейдемо до розворотів.",
      "IFRNAV1.GOAL_Climb": "Набір висоти",
      "IFRNAV1.GOAL_Descend": "Зниження",
      "IFRNAV1.REWARD_Climb": "Наберіть та утримуйте висоту 1370 м (4500 футів)",
      "IFRNAV1.REWARD_Descend": "Знижуйтеся та утримуйте висоту 1220 м (4000 футів)",
      "IFRNAV1.STEP_CruisePower": "Вкажіть крейсерський режим двигуна {STR_THROTTLE_INCR}",
      "IFRNAV1.STEP_FullPower": "Вкажіть повний газ {STR_THROTTLE_INCR}",
      "IFRNAV1.STEP_Maintain4000ft": "Утримуйте висоту 1220 м (4000 футів)",
      "IFRNAV1.STEP_Maintain4500ft": "Утримуйте висоту 1370 м (4500 футів)",
      "IFRNAV1.STEP_Reach4000ft": "Підніміться на висоту 1220 м (4000 футів)",
      "IFRNAV1.STEP_Reach4500ft": "Підніміться на висоту 1370 м (4500 футів)",
      "IFRNAV1.STEP_ReducePower": "Зменшіть потужність {STR_THROTTLE_DECR}",
      "LOADING.TIPS.FSA_IFRNAV1_02": "Навчіться літати без опори на зовнішні орієнтири.",
      "LOADING.TIPS.FSA_IFRNAV1_03": "Працюйте з органами управління плавно, щоб не втратити контроль над літаком.",
      "LOADING.TIPS.FSA_IFRNAV1_04": "Зменшіть потужність у разі зниження, щоб не набирати швидкість.",
      "LOADING.TIPS.FSA_IFRNAV1_05": "Зосередьтеся на головному пілотажному дисплеї (PFD).",
      "MENU.TUTORIAL.DESC_IFRNAV1": "Наберіть висоту та увійдіть у хмару, щоб втратити візуальну орієнтацію.",
      "MENU.TUTORIAL.NAME_IFRNAV1": "Набір висоти та зниження"
    }
