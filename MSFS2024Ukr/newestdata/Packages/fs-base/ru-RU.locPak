      "LanguageDll.12905": "#2 Селектор топливного бака (%((A:FUEL TANK SELECTOR 2,ENUM))%{case}%{:0}Cut Off%{:1}All%{:2}Left%{:3}Right%{:4}Aux Left%{:5}Aux Right%{:6}Center%{:7}2nd Center%{:8}3rd Center%{:9}External%{:10}2nd External%{:11}Right Tip%{:12}Left Tip%{:13}Crossfeed%{:14}Crossfeed Left To Right%{:15}Crossfeed Right To Left%{:16}Both%{:17}All External%{else}Other%{end})",
      "LanguageDll.12906": "#3 Селектор топливного бака (%((A:FUEL TANK SELECTOR 3,ENUM))%{case}%{:0}Cut Off%{:1}All%{:2}Left%{:3}Right%{:4}Aux Left%{:5}Aux Right%{:6}Center%{:7}2nd Center%{:8}3rd Center%{:9}External%{:10}2nd External%{:11}Right Tip%{:12}Left Tip%{:13}Crossfeed%{:14}Crossfeed Left To Right%{:15}Crossfeed Right To Left%{:16}Both%{:17}All External%{else}Other%{end})",
