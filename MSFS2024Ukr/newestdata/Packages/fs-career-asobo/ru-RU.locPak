      "FREELANCE.MED_EMERGENCY_DISPATCHER_MALE": "Диспетчер экстренных служб",
      "FREELANCE.POWER_COMPANY_CONTRACTOR_FEMALE": "Подрядчик энергетической компании",
      "FREELANCE.POWER_COMPANY_CONTRACTOR_MALE": "Подрядчик энергетической компании",
      "FREELANCE.REGIONAL_COORDINATOR_FEMALE": "Региональный координатор",
      "FREELANCE.REGIONAL_COORDINATOR_MALE": "Региональный координатор",
      "FREELANCE.SAR_EMERGENCY_DISPATCHER_FEMALE": "Диспетчер экстренных служб",
      "FREELANCE.SAR_EMERGENCY_DISPATCHER_MALE": "Диспетчер экстренных служб",
