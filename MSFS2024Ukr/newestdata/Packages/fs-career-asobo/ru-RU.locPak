      "PrivateCharter.VO__PILOT__PrivateCharter__PlaneCopilot__PreflightCockpitData__010__M__Generic__1": "Взлетные данные.",
      "PrivateCharter.VO__PILOT__PrivateCharter__PlaneCopilot__PreflightCockpit__010__M__Generic__1": "Подготовка кабины?",
